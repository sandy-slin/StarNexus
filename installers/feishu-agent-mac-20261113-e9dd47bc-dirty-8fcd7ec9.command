# ---------- relay（进会话聊天） ----------

RELAY_TIMEOUT_SEC = 120.0  # 实测一轮 5.8~10.4 秒，120 秒够它干点活
RELAY_MIN_TIMEOUT_SEC = 20.0  # 比这还短等于必然超时（固定开销就约 3 秒）
RELAY_EMPTY_REPLY = "（Cursor 这一轮没有文字回复）"
# 上游并发输家的原话（实测 2026.10.22）。认出来 ⇒ 换成人话，别把这句甩给手机用户
_OWNERSHIP_CHANGING = "ownership is currently changing"
WHY_RELAY_RACE = (
    "电脑上有人同时在用这个对话，Cursor 把手机这条挡掉了（没发进去，也没弄乱）。"
    "等那边停下来，再点 🔄 刷新重发一次。"
)

# 🔴 编辑器（IDE）里的对话：外部送不进去，**这一轮也不去试**。
# 不写 `state.vscdb`、不做 UI 自动化、不用深链（深链只能开新对话，还要人点一下）。
#
# 🔴 2026-11-07 第 17 轮纠正：原来这句写的是「Cursor 没给其他程序留这个口子」，**那是假话**。
# 官方钩子（`stop` / `subagentStop`）的返回值 `followup_message` 原文是「Cursor will
# automatically submit it as the next user message」，而且每个钩子都收到 `conversation_id`
# —— 往已有对话追加一句的口子**是有的**，官方文档就写着。
# 真正的拦路理由是**时机**：那个钩子只在一轮快结束时由 Cursor 自己叫起来，
# 公开文档里没有任何定时 / 监听 / 推送入口能从外面叫它（timer、idle、poll、webhook、
# listen、daemon 一个都没有；应用级钩子只有「打开工作区」那一个）。
# ⇒ 对一个**闲着的**编辑器对话，手机这边依然送不进去。结论没变，理由变了。
# 把假话留着的代价：下一轮谁想做「手机催一句」，读到那句会直接判定无路可走。
WHY_RELAY_IDE = (
    "编辑器里的对话，手机这边送不进去（也不会去动它的记录或者替你点界面）。"
    "想接着聊：在电脑上打开 Cursor 点开这个对话，或者在终端里用 cursor-agent 开一个，"
    "那种手机上就能发。"
)
# `cursor-agent --resume <编辑器那种 id>`：第 17 轮用**一次性对话**实测出结论了（没碰用户的）。
# 两件事：(1) 接不上编辑器那份历史，会用同一个 id 另起一个空的命令行对话；
# (2) 会把两边共用的那份导出记录**整份重写**（哨兵 276 B → 139 B，sha 变回报错那一行）。
# 闸门仍然在 `_cli_meta`：编辑器的 id 不在 `~/.cursor/chats/` 下 ⇒ 认不出 ⇒ 根本不会去 resume。
WHY_RELAY_IDE_RESUME_UNTESTED = (
    "拿命令行去接编辑器里那个对话，接不上 —— 它只会另起一个空的，还会把那边的聊天记录重写掉。"
    "所以手机这边不碰它。"
)

# ---------- 小工具 ----------


def valid_id(value: Any) -> bool:
    return isinstance(value, str) and bool(_ID_RE.match(value))


def _ro_uri(path: str) -> str:
    """只读打开 sqlite。`mode=ro` 会读 WAL（看得到最近几秒）；`immutable=1` 会漏，所以不用。"""
    return "file:" + urllib.parse.quote(os.path.abspath(path)) + "?mode=ro"


def _read_json_file(path: str, limit: int = 64 * 1024) -> Optional[dict]:
    try:
        with open(path, "rb") as handle:
            raw = handle.read(limit + 1)
    except OSError:
        return None
    if len(raw) > limit:  # meta.json 只有几行，大成这样肯定不是它
        return None
    try:
        data = json.loads(raw.decode("utf-8", errors="replace"))
    except ValueError:
        return None
    return data if isinstance(data, dict) else None


def _tail_lines(path: str, nbytes: int) -> list:
    """读文件尾部 nbytes；没从文件头开始读时丢掉第一行（多半是半截）。"""
    try:
        with open(path, "rb") as handle:
            handle.seek(0, os.SEEK_END)
            size = handle.tell()
            start = max(0, size - nbytes)
            handle.seek(start)
            raw = handle.read()
    except OSError:
        return []
    lines = raw.split(b"\n")
    if start > 0 and lines:
        lines = lines[1:]
    return [ln.decode("utf-8", errors="replace") for ln in lines if ln.strip()]


def _head_lines(path: str, nbytes: int) -> list:
    try:
        with open(path, "rb") as handle:
            raw = handle.read(nbytes)
    except OSError:
        return []
    lines = raw.split(b"\n")
    if len(raw) >= nbytes and lines:
        lines = lines[:-1]  # 最后一行可能被截断
    return [ln.decode("utf-8", errors="replace") for ln in lines if ln.strip()]


def _ms_to_epoch(value: Any) -> float:
    try:
        num = float(value)
    except (TypeError, ValueError):
        return 0.0
    if num <= 0:
        return 0.0
    return num / 1000.0 if num > 1e11 else num


def _file_uri_to_path(uri: Any) -> str:
    """`file:///Users/x/My%20Proj` → `/Users/x/My Proj`；不是本机文件夹（ssh 远程等）返回空。"""
    if not isinstance(uri, str) or not uri.startswith("file://"):
        return ""
    parsed = urllib.parse.urlparse(uri)
    return urllib.parse.unquote(parsed.path or "")


def _same_dir(a: str, b: str) -> bool:
    if not a or not b:
        return False
    try:
        return os.path.realpath(a) == os.path.realpath(b)
    except (OSError, ValueError):
        return False


# ---------- transcript 解析 ----------

_TIMESTAMP_RE = re.compile(r"<timestamp>(.*?)</timestamp>", re.S)
_USER_QUERY_RE = re.compile(r"<user_query>\s*(.*?)\s*</user_query>", re.S)
_TS_TEXT_RE = re.compile(
    r"^\s*\w+,\s*(\w{3})\w*\s+(\d{1,2}),\s*(\d{4}),\s*(\d{1,2}):(\d{2})\s*([AP]M)"
    r"(?:\s*\(UTC([+-]\d{1,2})(?::?(\d{2}))?\))?",
    re.I,
)
_MONTHS = {m: i for i, m in enumerate(
    ("jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"), start=1
)}
# 不是人说的话：Cursor 自己塞进对话的东西（工具目录、上下文压缩的摘要）
_INJECTED_PREFIXES = ("<mcp_server_catalog>", "<mcp_meta_tool_server", "<system_reminder>", "<system-reminder>")
_SUMMARY_PREFIX = "This session is being continued from a previous conversation"
SUMMARY_NOTE = "（之前聊得太长，Cursor 自动压缩成了一段摘要）"
_TASK_NUDGE_PREFIX = "Briefly inform the user about the task result"


def _parse_ts_text(text: str) -> float:
    """`Sunday, Nov 1, 2026, 7:27 PM (UTC+8)` → epoch；认不出返回 0。"""
    m = _TS_TEXT_RE.match(text or "")
    if not m:
        return 0.0
    mon, day, year, hh, mm, ampm, off_h, off_m = m.groups()
    month = _MONTHS.get(mon[:3].lower())
    if month is None:
        return 0.0
    try:
        hour = int(hh) % 12 + (12 if ampm.upper() == "PM" else 0)
        offset = _dt.timedelta(hours=int(off_h or 0))
        if off_m:
            offset += _dt.timedelta(minutes=int(off_m)) * (1 if int(off_h or 0) >= 0 else -1)
        stamp = _dt.datetime(int(year), month, int(day), hour, int(mm), tzinfo=_dt.timezone(offset))
    except (ValueError, OverflowError):
        return 0.0
    return stamp.timestamp()


def _text_parts(record: dict) -> str:
    message = record.get("message")
    if not isinstance(message, dict):
        return ""
    content = message.get("content")
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    texts = []
    for part in content:
        if isinstance(part, dict) and part.get("type") == "text" and isinstance(part.get("text"), str):
            texts.append(part["text"])
    return "\n".join(t for t in texts if t.strip())


def clean_user_text(text: str) -> tuple:
    """去掉 `<timestamp>` / `<user_query>` 包装 → (正文, 时间)。不是人说的话 ⇒ 正文为空。"""
    at = 0.0
    stamp = _TIMESTAMP_RE.search(text)
    if stamp:
        at = _parse_ts_text(stamp.group(1))
    query = _USER_QUERY_RE.search(text)
    if query:
        body = query.group(1).strip()
        # Cursor 后台任务跑完后自己塞的一句「去告诉用户结果」，也包在 user_query 里（实测 201 次）
        return ("" if body.startswith(_TASK_NUDGE_PREFIX) else body), at
    body = _TIMESTAMP_RE.sub("", text).strip()
    if body.startswith(_INJECTED_PREFIXES):
        return "", at
    if body.startswith(_SUMMARY_PREFIX):
        return SUMMARY_NOTE, at
    return body, at


def parse_transcript_line(line: str) -> Optional[Message]:
    """一行 transcript → Message；工具调用、turn_ended、坏行 ⇒ None。"""
    try:
        record = json.loads(line)
    except ValueError:
        return None
    if not isinstance(record, dict):
        return None
    role = record.get("role")
    if role not in ("user", "assistant"):
        return None
    text = _text_parts(record)
    at = 0.0
    if role == "user":
        text, at = clean_user_text(text)
    text = text.strip()
    if not text:
        return None
    return Message(role=role, text=text, at=at)


def reply_after_echo(lines, sent: str) -> str:
    """transcript 的行 → 我们这句（`sent`）之后的 assistant 文字；没找到回显 ⇒ 空串。

    回显之前的 assistant 行属于**上一轮**，一概不要 —— 不然用户会把上一轮的回答
    当成这句的答案。同一句话发过两次时取**最后一次**回显后面的。
    """
    wanted = " ".join(str(sent or "").split())
    if not wanted:
        return ""
    parsed = [parse_transcript_line(ln) for ln in lines or ()]
    start = -1
    for i, msg in enumerate(parsed):
        if msg is not None and msg.role == "user" and wanted in " ".join(msg.text.split()):
            start = i
    if start < 0:
        return ""
    out = []
    for msg in parsed[start + 1:]:
        if msg is None:
            continue
        if msg.role == "user":
            break  # 下一轮开始了
        out.append(msg.text)
    return "\n".join(out).strip()


def first_user_query(path: str) -> str:
    """transcript 开头第一句用户话，当标题用。"""
    for line in _head_lines(path, TITLE_HEAD_BYTES):
        msg = parse_transcript_line(line)
        if msg is not None and msg.role == "user" and msg.text != SUMMARY_NOTE:
            return msg.text
    return ""


# ---------- 进程 ----------


@dataclass(frozen=True)
class AgentProc:
    """电脑上一个 cursor-agent 对话进程（不是 worker-server）。"""

    pid: int
    chat_id: str  # 认不出 ⇒ ""
    printing: bool  # 带 -p：正在答一条；不带：交互界面，忙不忙看不出
    workspace: str  # argv 里的 --workspace；没有 ⇒ ""


def _agent_tokens(args: str) -> Optional[list]:
    """是 cursor-agent 主进程 ⇒ index.js 之后的参数；不是 ⇒ None。"""
    m = _AGENT_RE.search(args or "")
    if not m:
        return None
    return args[m.end():].split()


def is_worker_server(args: str) -> bool:
    tokens = _agent_tokens(args)
    return bool(tokens) and tokens[0] == "worker-server"


def parse_agent_args(pid: int, args: str) -> Optional[AgentProc]:
    """ps 的一行 args → AgentProc；worker-server、跑完就退的子命令 ⇒ None。

    参数是按空白拆的（ps 不保留引号），只用来认旗标；提示词里有空格不影响。
    """
    tokens = _agent_tokens(args)
    if tokens is None:
        return None
    if tokens and (tokens[0] == "worker-server" or tokens[0] in _NONCHAT_WORDS):
        return None
    if "--list-models" in tokens:
        return None
    chat_id = ""
    workspace = ""
    printing = False
    for i, tok in enumerate(tokens):
        if tok == "--":
            break
        if tok in ("-p", "--print"):
            printing = True
        elif tok == "--resume" and i + 1 < len(tokens) and valid_id(tokens[i + 1]):
            chat_id = tokens[i + 1]
        elif tok.startswith("--resume=") and valid_id(tok.split("=", 1)[1]):
            chat_id = tok.split("=", 1)[1]
        elif tok == "--workspace" and i + 1 < len(tokens):
            workspace = tokens[i + 1]
        elif tok.startswith("--workspace="):
            workspace = tok.split("=", 1)[1]
    return AgentProc(pid=int(pid), chat_id=chat_id, printing=printing, workspace=workspace)


def parse_lsof_cwd(text: str) -> dict:
    """`lsof -a -p 1,2 -d cwd -Fpn` 的输出 → {pid: cwd}。"""
    out: dict = {}
    pid = 0
    for line in (text or "").splitlines():
        if line.startswith("p"):
            try:
                pid = int(line[1:])
            except ValueError:
                pid = 0
        elif line.startswith("n") and pid:
            out[pid] = line[1:]
    return out


def parse_result(stdout: str) -> Optional[dict]:
    """`--output-format json` 的结果对象（取最后一个能解析的 JSON 行）。"""
    for line in reversed((stdout or "").strip().splitlines()):
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            data = json.loads(line)
        except ValueError:
            continue
        if isinstance(data, dict):
            return data
    return None


# ---------- 按对话串行 ----------

_SEND_LOCKS: dict = {}
_SEND_LOCKS_GUARD = threading.Lock()


def _send_lock(key: str) -> threading.Lock:
    """全进程共用：同一个对话不管经过哪个 adapter 实例，同一时刻只有一条在发。"""
    with _SEND_LOCKS_GUARD:
        lock = _SEND_LOCKS.get(key)
        if lock is None:
            lock = _SEND_LOCKS[key] = threading.Lock()
        return lock


# 手机上的权限档位 → cursor-agent 旗标。`-p` 默认什么工具都能用（含 shell），
# 所以只读档必须显式收成 `--mode ask`；认不出的档位一律按只读（fail-closed，抄 policy.clamp_mode）。
MODE_FLAGS = {
    "readonly": ("--mode", "ask"),
    "write": (),
    "trusted": ("--force",),
}


@dataclass
class _ChatMeta:
    id: str
    cwd: str
    created_at: float
    updated_at: float
    has_conversation: bool
    path: str


@dataclass
class _WorkerWatch:
    """发送期间盯着我们那个子进程，记下它生出来的 worker-server。"""

    pid: int = 0
    lstart: str = ""
    seen: dict = field(default_factory=dict)  # worker pid -> Proc（第一次看到时）
    stop: threading.Event = field(default_factory=threading.Event)
    thread: Optional[threading.Thread] = None


class CursorAdapter(Adapter):
    tool = "cursor"
    RUNNING_NOTE = UNKNOWN_IDE_NOTE

    def __init__(
        self,
        cursor_home: str = DEFAULT_CURSOR_HOME,
        app_user: str = DEFAULT_APP_USER,
        *,
        jobs: Optional[FleetJobs] = None,
        runner: Optional[SubprocessRunner] = None,
        agent_bin: Optional[str] = None,
        procs: Optional[Callable[[], ProcTable]] = None,
        mode: Any = "readonly",
        worker_poll_sec: float = WORKER_POLL_SEC,
    ) -> None:
        super().__init__(jobs=jobs, runner=runner)
        self.cursor_home = cursor_home
        self.app_user = app_user
        self._agent_bin = agent_bin
        self._procs_factory = procs
        self._mode = mode  # 字符串，或返回字符串的函数（跟着聊天里切的档位走）
        self.worker_poll_sec = worker_poll_sec

    # ---------- 路径 ----------

    @property
    def chats_dir(self) -> str:
        return os.path.join(self.cursor_home, "chats")

    @property
    def projects_dir(self) -> str:
        return os.path.join(self.cursor_home, "projects")

    @property
    def state_db(self) -> str:
        return os.path.join(self.app_user, "globalStorage", "state.vscdb")

    def agent_bin(self) -> str:
        """cursor-agent 在哪；后台服务的 PATH 常常很短，所以再看一眼默认安装位置。"""
        if self._agent_bin is not None:
            return self._agent_bin if os.path.isfile(self._agent_bin) else ""
        found = shutil.which("cursor-agent")
        if found:
            return found
        fallback = os.path.expanduser("~/.local/bin/cursor-agent")
        return fallback if os.path.isfile(fallback) else ""

    def _procs(self) -> ProcTable:
        if self._procs_factory is not None:
            try:
                return self._procs_factory()
            except Exception as exc:
                return ProcTable(error=friendly_error(exc, "读不到进程列表"))
        return ProcTable.snapshot(self.runner)

    def _current_mode(self, override: Optional[str] = None) -> str:
        """档位：字符串 / 返回字符串的函数 / 带 `.mode` 的 Policy 都行。认不出 ⇒ 只读。"""
        mode = override if override is not None else self._mode
        if callable(mode):
            try:
                mode = mode()
            except Exception:
                mode = "readonly"
        mode = getattr(mode, "mode", mode)
        return mode if isinstance(mode, str) and mode in MODE_FLAGS else "readonly"

    # ---------- 命令行对话：chats/*/<id>/meta.json ----------

    def _load_meta(self, path: str, chat_id: str) -> Optional[_ChatMeta]:
        data = _read_json_file(path)
        if data is None:
            return None
        cwd = data.get("cwd") if isinstance(data.get("cwd"), str) else ""
        return _ChatMeta(
            id=chat_id,
            cwd=cwd,
            created_at=_ms_to_epoch(data.get("createdAtMs")),
            updated_at=_ms_to_epoch(data.get("updatedAtMs")),
            has_conversation=data.get("hasConversation") is True,
            path=path,
        )

    def _cli_metas(self) -> list:
        """所有命令行对话（含没聊过的），不排序。两层 scandir，不递归。"""
        out = []
        try:
            with os.scandir(self.chats_dir) as groups:
                group_paths = [g.path for g in groups if g.is_dir(follow_symlinks=False)]
        except FileNotFoundError:
            return []
        except OSError as exc:
            self.last_error = friendly_error(exc, "读不到 Cursor 命令行对话")
            return []
        for group in group_paths:
            try:
                with os.scandir(group) as chats:
                    entries = [(c.name, c.path) for c in chats if c.is_dir(follow_symlinks=False)]
            except OSError:
                continue
            for name, path in entries:
                if not valid_id(name):
                    continue
                meta = self._load_meta(os.path.join(path, "meta.json"), name)
                if meta is not None:
                    out.append(meta)
        return out

    def _cli_meta(self, chat_id: str) -> Optional[_ChatMeta]:
        """按 id 找一个命令行对话（不知道它在哪个 md5 目录下，挨个看一眼）。"""
        if not valid_id(chat_id):
            return None
        try:
            with os.scandir(self.chats_dir) as groups:
                group_paths = [g.path for g in groups if g.is_dir(follow_symlinks=False)]
        except OSError:
            return None
        for group in group_paths:
            path = os.path.join(group, chat_id, "meta.json")
            if os.path.isfile(path):
                return self._load_meta(path, chat_id)
        return None

    # ---------- transcript：projects/*/agent-transcripts/<id>/<id>.jsonl ----------

    def find_transcripts(self, ids) -> dict:
        """按 id 找 transcript → {id: 路径}。不自己算目录名（命令行和 chats 用的路径写法不一样）。

        同一个 id 可能出现在两个项目目录下（`--workspace` 换过写法），取最近改过的那个。
        """
        wanted = {i for i in ids if valid_id(i)}
        if not wanted:
            return {}
        try:
            with os.scandir(self.projects_dir) as it:
                projects = [e.path for e in it if e.is_dir(follow_symlinks=False)]
        except OSError:
            return {}
        found: dict = {}
        # 每个项目目录列一次 agent-transcripts，和要找的 id 求交集：
        # 次数 = 项目数，不是 项目数 × id 数（list(200) 时差几十倍）
        for project in projects:
            try:
                with os.scandir(os.path.join(project, "agent-transcripts")) as it:
                    hits = [e.name for e in it if e.name in wanted]
            except OSError:
                continue
            for chat_id in hits:
                path = os.path.join(project, "agent-transcripts", chat_id, chat_id + ".jsonl")
                try:
                    mtime = os.stat(path).st_mtime
                except OSError:
                    continue
                if chat_id not in found or mtime > found[chat_id][1]:
                    found[chat_id] = (path, mtime)
        return {k: v[0] for k, v in found.items()}

    def find_transcript(self, chat_id: str) -> str:
        return self.find_transcripts([chat_id]).get(chat_id, "")

    # ---------- 编辑器对话：state.vscdb 的 composerHeaders（只读） ----------

    def _ide_rows(self, limit: int) -> list:
        """composerHeaders 最近 limit 条 → [dict]。库不在、表不在 ⇒ []；**不碰 cursorDiskKV**。"""
        if limit <= 0 or not os.path.isfile(self.state_db):
            return []
        try:
            conn = sqlite3.connect(_ro_uri(self.state_db), uri=True, timeout=SQLITE_TIMEOUT_SEC)
        except sqlite3.Error as exc:
            self.last_error = friendly_error(exc, "打不开 Cursor 的对话列表")
            return []
        try:
            cols = {row[1] for row in conn.execute("PRAGMA table_info(composerHeaders)")}
            if "composerId" not in cols:  # 表不在（老版本 / 没用过编辑器里的 agent）
                return []
            pick = [c for c in ("composerId", "workspaceId", "createdAt", "lastUpdatedAt",
                                "isArchived", "isSubagent", "value") if c in cols]
            where = ["composerId not like 'empty%'"]
            if "isSubagent" in cols:
                where.append("coalesce(isSubagent, 0) = 0")
            order = " order by lastUpdatedAt desc" if "lastUpdatedAt" in cols else ""
            sql = f"select {', '.join(pick)} from composerHeaders where {' and '.join(where)}{order} limit ?"
            rows = conn.execute(sql, (int(limit),)).fetchall()
        except sqlite3.Error as exc:
            self.last_error = friendly_error(exc, "读 Cursor 的对话列表失败")
            return []
        finally:
            conn.close()
        return [dict(zip(pick, row)) for row in rows]

    def _workspace_folder(self, workspace_id: Any) -> str:
        """workspaceStorage/<id>/workspace.json 里的 folder（点查一个小文件）。"""
        if not isinstance(workspace_id, str) or not valid_id(workspace_id):
            return ""
        data = _read_json_file(os.path.join(self.app_user, "workspaceStorage", workspace_id, "workspace.json"))
        return _file_uri_to_path((data or {}).get("folder"))

    def _ide_session(self, row: dict, transcript: str) -> Optional[Session]:
        chat_id = row.get("composerId")
        if not valid_id(chat_id):
            return None
        try:
            value = json.loads(row.get("value") or "{}")
        except (TypeError, ValueError):
            value = {}
        if not isinstance(value, dict):
            value = {}
        if value.get("isDraft") and not value.get("name") and not transcript:
            return None  # 只开了个空输入框，什么都没聊
        cwd = ""
        for holder in (value.get("workspaceIdentifier"), (value.get("agentLocation") or {}).get("environment")
                       if isinstance(value.get("agentLocation"), dict) else None):
            uri = holder.get("uri") if isinstance(holder, dict) else None
            if isinstance(uri, dict):
                if uri.get("scheme", "file") == "file" and isinstance(uri.get("fsPath"), str):
                    cwd = uri["fsPath"]
                    break
        if not cwd:
            cwd = self._workspace_folder(row.get("workspaceId"))
        title = value.get("name") if isinstance(value.get("name"), str) else ""
        if not title and transcript:
            title = first_user_query(transcript)
        extra = {"source": "ide", "status_note": UNKNOWN_IDE_NOTE, "archived": bool(row.get("isArchived"))}
        if isinstance(value.get("unifiedMode"), str):
            extra["mode"] = value["unifiedMode"]
        return Session(
            tool="cursor",
            surface="app",
            id=chat_id,
            title=short_title(title or "（没有标题）"),
            cwd=cwd,
            status="unknown",
            owner="app",
            updated_at=_ms_to_epoch(row.get("lastUpdatedAt") or value.get("lastUpdatedAt")),
            can_send=False,
            can_stop=False,
            why_not_send=WHY_IDE_SEND,
            why_not_stop=WHY_IDE_STOP,
            extra=extra,
        )

    def _is_ide_chat(self, chat_id: str) -> bool:
        """点查一行：这个 id 是不是编辑器里的对话（只为了给出对的拒绝理由）。"""
        if not valid_id(chat_id) or not os.path.isfile(self.state_db):
            return False
        try:
            conn = sqlite3.connect(_ro_uri(self.state_db), uri=True, timeout=SQLITE_TIMEOUT_SEC)
        except sqlite3.Error:
            return False
        try:
            row = conn.execute("select 1 from composerHeaders where composerId = ? limit 1", (chat_id,)).fetchone()
        except sqlite3.Error:
            return False
        finally:
            conn.close()
        return row is not None

    # ---------- 谁开着哪个对话 ----------

    def _lsof_cwds(self, pids) -> Optional[dict]:
        """一次 lsof 拿这些进程的当前目录；读失败 ⇒ None（调用方按「看不清」处理）。"""
        pids = [str(int(p)) for p in pids]
        if not pids:
            return {}
        try:
            result = self.runner.run(
                [resolve_lsof(), "-a", "-p", ",".join(pids), "-d", "cwd", "-Fpn"], timeout=LSOF_TIMEOUT_SEC
            )
        except Exception as exc:
            logger.warning("lsof 失败：%s", exc)
            return None
        if result.error or result.timed_out:
            return None
        # 有的 pid 刚好退出时 lsof 退出码是 1，但别的行照样有用
        return parse_lsof_cwd(result.stdout)

    def _scan(self, table: ProcTable) -> dict:
        """一张 ps 表 → 我们的 / 外来认得出的 / 外来认不出的 cursor-agent。"""
        ours: dict = {}
        for job in self.jobs.jobs(tool=self.tool):
            if self.jobs.owns(job.pid, table):
                ours.setdefault(job.session_id, []).append(job.pid)
        foreign: dict = {}
        unknown: list = []
        for proc in table:
            if self.jobs.get(proc.pid) is not None and self.jobs.owns(proc.pid, table):
                continue
            agent = parse_agent_args(proc.pid, proc.args)
            if agent is None:
                continue
            if agent.chat_id:
                foreign.setdefault(agent.chat_id, []).append(agent)
            else:
                unknown.append(agent)
        cwds = self._lsof_cwds([a.pid for a in unknown]) if unknown else {}
        unknown_cwds = []
        for agent in unknown:
            cwd = (cwds or {}).get(agent.pid, "")
            if not cwd and agent.workspace.startswith("/"):
                cwd = agent.workspace
            unknown_cwds.append((agent, cwd))
        return {"ours": ours, "foreign": foreign, "unknown": unknown_cwds, "error": table.error}

    def _state_for(self, meta: _ChatMeta, scan: dict) -> dict:
        """一个命令行对话现在的状态 + 能不能发 / 停。"""
        ours = scan["ours"].get(meta.id, [])
        foreign = scan["foreign"].get(meta.id, [])
        if scan["error"]:
            return dict(status="unknown", owner="unknown", pids=(), can_send=False, can_stop=False,
                        why_not_send=WHY_UNSEEN_SEND, why_not_stop=WHY_IDLE_STOP)
        if ours:
            return dict(status="running", owner="bridge", pids=tuple(ours), can_send=False, can_stop=True,
                        why_not_send=WHY_BUSY_SEND, why_not_stop="")
        if foreign:
            # 外来进程忙不忙没实测过（只知道它开着）⇒ 状态 unknown，只说「开着」
            return dict(status="unknown", owner="terminal",
                        pids=tuple(a.pid for a in foreign), can_send=False, can_stop=False,
                        why_not_send=WHY_TERMINAL_SEND, why_not_stop=WHY_TERMINAL_STOP,
                        extra={"open_elsewhere": True, "printing": any(a.printing for a in foreign)})
        maybe = [a for a, cwd in scan["unknown"] if not cwd or _same_dir(cwd, meta.cwd)]
        if maybe:
            return dict(status="unknown", owner="unknown", pids=(), can_send=False, can_stop=False,
                        why_not_send=WHY_MAYBE_SEND, why_not_stop=WHY_TERMINAL_STOP,
                        extra={"maybe_pids": [a.pid for a in maybe]})
        if not meta.cwd or not os.path.isdir(meta.cwd):
            return dict(status="idle", owner="none", pids=(), can_send=False, can_stop=False,
                        why_not_send=WHY_NO_CWD, why_not_stop=WHY_IDLE_STOP)
        return dict(status="idle", owner="none", pids=(), can_send=True, can_stop=False,
                    why_not_send="", why_not_stop=WHY_IDLE_STOP)

    def _cli_session(self, meta: _ChatMeta, scan: dict, transcript: str) -> Session:
        state = dict(self._state_for(meta, scan))
        extra = {"source": "cli"}
        extra.update(state.pop("extra", {}))
        title = first_user_query(transcript) if transcript else ""
        return Session(
            tool="cursor",
            surface="cli",
            id=meta.id,
            title=short_title(title or "（命令行对话，还没有记录）"),
            cwd=meta.cwd,
            updated_at=meta.updated_at,
            extra=extra,
            **state,
        )

    # ---------- 公开方法 ----------

    def list(self, limit: int = 20) -> list:
        """最近的对话：命令行 + 编辑器，在跑的在前，其余按最后更新时间倒序。读失败返回已有的。"""
        self.last_error = ""
        try:
            limit = max(0, int(limit))
        except (TypeError, ValueError):
            limit = 20
        if limit == 0:
            return []
        metas = [m for m in self._cli_metas() if m.has_conversation]
        metas.sort(key=lambda m: m.updated_at, reverse=True)
        metas = metas[:limit]
        rows = self._ide_rows(limit * 2)  # 多拿一些：空草稿会被跳过
        cli_ids = {m.id for m in metas}
        rows = [r for r in rows if r.get("composerId") not in cli_ids]
        transcripts = self.find_transcripts([m.id for m in metas] + [
            r.get("composerId") for r in rows if isinstance(r.get("composerId"), str)
        ])
        sessions = []
        if metas:
            scan = self._scan(self._procs())
            if scan["error"]:
                self.last_error = scan["error"]
            sessions += [self._cli_session(m, scan, transcripts.get(m.id, "")) for m in metas]
        for row in rows:
            try:
                sess = self._ide_session(row, transcripts.get(row.get("composerId"), ""))
            except Exception as exc:  # 格式没文档、跨版本会变：一行坏了跳过这一行
                logger.warning("跳过一条读不懂的 Cursor 对话：%s", exc)
                continue
            if sess is not None:
                sessions.append(sess)
        # 在跑的、电脑上正开着的排前面，其余按最后更新时间
        sessions.sort(key=lambda s: (s.status != "running" and not s.pids, -s.updated_at))
        return sessions[:limit]

    def running(self) -> list:
        """现在电脑上开着的命令行对话。编辑器里的看不出来，不列（见 RUNNING_NOTE）。"""
        self.last_error = ""
        table = self._procs()
        if table.error:
            self.last_error = table.error
            return []
        scan = self._scan(table)
        ids = list(scan["ours"]) + [i for i in scan["foreign"] if i not in scan["ours"]]
        if not ids and not scan["unknown"]:
            return []
        transcripts = self.find_transcripts(ids)
        out = []
        for chat_id in ids:
            meta = self._cli_meta(chat_id) or _ChatMeta(
                id=chat_id, cwd="", created_at=0, updated_at=0, has_conversation=True, path=""
            )
            out.append(self._cli_session(meta, scan, transcripts.get(chat_id, "")))
        for agent, cwd in scan["unknown"]:
            out.append(Session(
                tool="cursor",
                surface="cli",
                id=f"pid-{agent.pid}",
                title=short_title(f"cursor-agent（{os.path.basename(cwd) or '不知道哪个项目'}）"),
                cwd=cwd,
                status="unknown",
                pids=(agent.pid,),
                owner="terminal",
                can_send=False,
                can_stop=False,
                why_not_send=WHY_FOREIGN_UNKNOWN,
                why_not_stop=WHY_TERMINAL_STOP,
                extra={"source": "cli", "unmatched": True},
            ))
        return out

    def read(self, id: str, n: int = 4) -> list:
        """最近 n 条（人说的 + Cursor 回的文字，不含工具调用），旧的在前。"""
        self.last_error = ""
        try:
            n = max(0, int(n))
        except (TypeError, ValueError):
            n = 4
        if n == 0 or not valid_id(id):
            return []
        path = self.find_transcript(id)
        if not path:
            self.last_error = "这个对话还没有能读的记录。"
            return []
        messages = []
        for line in _tail_lines(path, READ_TAIL_BYTES):
            msg = parse_transcript_line(line)
            if msg is not None:
                messages.append(msg)
        return messages[-n:]

    def stop(self, id: str) -> ActionResult:
        """只停手机上起的；终端里的、编辑器里的一律不碰。"""
        if not valid_id(id):
            return ActionResult(False, "这个对话认不出来。", str(id))
        if self.jobs.jobs(tool=self.tool, session_id=id):
            return self.stop_own(id)
        if self._cli_meta(id) is None and self._is_ide_chat(id):
            return ActionResult(False, WHY_IDE_STOP, id)
        table = self._procs()
        scan = self._scan(table)
        if scan["foreign"].get(id) or id.startswith("pid-"):
            return ActionResult(False, WHY_TERMINAL_STOP, id)
        return ActionResult(False, WHY_IDLE_STOP, id)

    def build_argv(self, binary: str, chat_id: str, cwd: str, text: str, mode: str) -> list:
        """`cursor-agent --resume <id> -p --output-format json --trust --workspace <cwd> [档位] -- <text>`。

        `--` 之后才是用户的话：手机上发一句以 `-` 开头的话，不能被当成旗标。
        """
        return [
            binary, "--resume", chat_id, "-p", "--output-format", "json", "--trust",
            "--workspace", cwd, *MODE_FLAGS.get(mode, MODE_FLAGS["readonly"]), "--", text,
        ]

    # ---------- relay：进会话聊天 ----------

    def relay(self, id: str, text: str, timeout: float = RELAY_TIMEOUT_SEC,
              mode: Any = None) -> ActionResult:
        """连续多轮地跟一个**命令行**对话说话（`--resume` 同一个 chat）。

        和 `send()` 的区别只在**取回复**和**拒绝话术**：
        - `--output-format json` 的 `result` 就是这一轮的回复（同步拿到，不用轮询文件）；
        - 它没给文字时，退回去读 transcript 的尾部，**按内容**找我们这句的回显再取后面的回复
          （不能用字节偏移：CLI 的 transcript 是整文件重写的，见模块头）；
        - 并发输家的上游原话换成人话；编辑器里的对话给出能做到的替代。

        同一个 chat 串行（`_send_lock`），不同 chat 可以并行 —— 实测锁的粒度就该是 chatId。
        """
        if not valid_id(id) or id.startswith("pid-"):
            return ActionResult(False, "这个对话认不出来。", str(id))
        text = (text or "").strip()
        if not text:
            return ActionResult(False, "要说的话是空的。", id)
        if len(text) > MAX_SEND_CHARS:
            return ActionResult(False, f"一次最多发 {MAX_SEND_CHARS} 个字，这条太长了。", id)
        meta = self._cli_meta(id)
        if meta is None:
            # 编辑器里的对话：这里就拦住，不去 resume、不写它的库、不碰界面
            if self._is_ide_chat(id):
                return ActionResult(False, WHY_RELAY_IDE, id)
            return ActionResult(False, "找不到这个 Cursor 命令行对话，可能已经删了。", id)
        binary = self.agent_bin()
        if not binary:
            return ActionResult(False, WHY_NO_BIN, id)
        lock = _send_lock(os.path.realpath(self.cursor_home) + "\0" + id)
        if not lock.acquire(blocking=False):
            return ActionResult(False, WHY_BUSY_SEND, id)
        try:
            state = self._state_for(meta, self._scan(self._procs()))
            if not state["can_send"]:
                return ActionResult(False, state["why_not_send"], id)
            spawned: list = []
            sure_not_sent: list = []
            res = self._relay_locked(meta, binary, text, timeout, self._current_mode(mode),
                                     spawned, sure_not_sent)
            # 起过子进程 ⇒ 默认当 delivered（宁可让用户去看一眼，也不能骗他「没发进去」
            # 然后他重发、在真实对话里跑第二遍）。**例外**：拿到了「这条确实没进去」的
            # 实测证据（并发输家）⇒ 照实说没进去，让他放心重发。
            if spawned and not res.delivered and not sure_not_sent:
                res = ActionResult(res.ok, res.text, res.session_id, delivered=True)
            return res
        finally:
            lock.release()

    def _relay_locked(self, meta: _ChatMeta, binary: str, text: str, timeout: float, mode: str,
                      spawned: Optional[list] = None,
                      sure_not_sent: Optional[list] = None) -> ActionResult:
        timeout = max(RELAY_MIN_TIMEOUT_SEC, float(timeout or RELAY_TIMEOUT_SEC))
        raw: list = []
        res = self._send_locked(meta, binary, text, timeout, mode, spawned, raw)
        if res.ok and res.text and res.text != RELAY_EMPTY_REPLY:
            return res
        # 认并发输家要看**未截断**的 stderr：`_to_action` 只放得下 200 字
        blob = (res.text or "") + "\n" + "\n".join(
            (r.stderr or "") + "\n" + (r.stdout or "") for r in raw
        )
        if _OWNERSHIP_CHANGING in blob:
            # 上游响亮失败：**没进去**（输家 0.35~0.47 秒就退，transcript 没坏行）
            if sure_not_sent is not None:
                sure_not_sent.append(True)
            return ActionResult(False, WHY_RELAY_RACE, meta.id, delivered=False)
        if res.ok:
            # 跑成功但 json 里没文字 ⇒ 去 transcript 里找（有时文字只落在记录里）
            found = self.reply_after(meta.id, text)
            if found:
                return ActionResult(True, found, meta.id, delivered=True)
            return ActionResult(True, RELAY_EMPTY_REPLY, meta.id, delivered=res.delivered)
        return res

    def reply_after(self, chat_id: str, sent: str) -> str:
        """transcript 尾部：找到我们这句的 user 回显，返回它后面的 assistant 文字。

        **按内容找，不用字节偏移** —— CLI 的 transcript 是整文件重写的（见模块头那条）。
        找不到回显就返回空串（宁可说「没有文字回复」，也不能把上一轮的回答当成这句的）。
        """
        if not valid_id(chat_id):
            return ""
        path = self.find_transcript(chat_id)
        if not path:
            return ""
        return reply_after_echo(_tail_lines(path, READ_TAIL_BYTES), sent)

    def relay_stop(self, id: str) -> ActionResult:
        """relay 这条路上的 `/stop`：只停手机上起的那一轮，别人的说清楚在哪停。"""
        return self.stop(id)

    def send(self, id: str, text: str, timeout: float = 600, mode: Any = None) -> ActionResult:
        """往命令行对话里接着说一句。只在**确认没人开着它**时发；同一个对话同一时刻只发一条。"""
        if not valid_id(id) or id.startswith("pid-"):
            return ActionResult(False, "这个对话认不出来。", str(id))
        text = (text or "").strip()
        if not text:
            return ActionResult(False, "要说的话是空的。", id)
        if len(text) > MAX_SEND_CHARS:
            return ActionResult(False, f"一次最多发 {MAX_SEND_CHARS} 个字，这条太长了。", id)
        meta = self._cli_meta(id)
        if meta is None:
            if self._is_ide_chat(id):
                return ActionResult(False, WHY_IDE_SEND, id)
            return ActionResult(False, "找不到这个 Cursor 命令行对话，可能已经删了。", id)
        binary = self.agent_bin()
        if not binary:
            return ActionResult(False, WHY_NO_BIN, id)
        lock = _send_lock(os.path.realpath(self.cursor_home) + "\0" + id)
        if not lock.acquire(blocking=False):
            return ActionResult(False, WHY_BUSY_SEND, id)
        try:
            # 锁里再查一次：等锁、点按钮的这几秒里，电脑上可能刚好打开了它
            state = self._state_for(meta, self._scan(self._procs()))
            if not state["can_send"]:
                return ActionResult(False, state["why_not_send"], id)
            spawned: list = []
            res = self._send_locked(meta, binary, text, timeout, self._current_mode(mode), spawned)
            # 起过子进程 ⇒ 消息已经进了会话（不管后面超时 / 被停 / 报错）
            if spawned and not res.delivered:
                res = ActionResult(res.ok, res.text, res.session_id, delivered=True)
            return res
        finally:
            lock.release()

    def _send_locked(self, meta: _ChatMeta, binary: str, text: str, timeout: float, mode: str,
                     spawned: Optional[list] = None, raw: Optional[list] = None) -> ActionResult:
        """`raw`：给它一个 list，会把原始 `RunResult` 放进去（relay 要看未截断的 stderr）。"""
        watch = _WorkerWatch()
        spawned = spawned if spawned is not None else []

        def on_spawn(pid: int) -> None:
            spawned.append(pid)
            job = self.jobs.register_spawned(pid, self.tool, meta.id)
            watch.pid = pid
            watch.lstart = job.lstart if job else ""
            watch.thread = threading.Thread(target=self._watch_workers, args=(watch,), daemon=True,
                                            name=f"cursor-worker-watch-{pid}")
            watch.thread.start()

        argv = self.build_argv(binary, meta.id, meta.cwd, text, mode)
        try:
            result = self.runner.run(argv, timeout=float(timeout), cwd=meta.cwd, on_spawn=on_spawn)
        except Exception as exc:  # runner 可注入，防它自己炸
            result = RunResult(returncode=-1, error=friendly_error(exc, "没能启动 cursor-agent"))
        finally:
            watch.stop.set()
            if watch.thread is not None:
                watch.thread.join(timeout=max(self.worker_poll_sec * 4, 2.0))
            if watch.pid:
                self.jobs.forget(watch.pid)
        try:
            self._reap_workers(watch, meta.cwd)
        except Exception:
            logger.exception("收 worker-server 时出错（不影响这次发送的结果）")
        if raw is not None:
            raw.append(result)
        return self._to_action(meta.id, result)

    def _to_action(self, chat_id: str, result: RunResult) -> ActionResult:
        if result.error:
            return ActionResult(False, result.error, chat_id)
        if result.timed_out:
            return ActionResult(False, "等太久没回完，已经把这一轮停掉了。可以再发一次试试。", chat_id)
        data = parse_result(result.stdout) or {}
        reply = data.get("result") if isinstance(data.get("result"), str) else ""
        if result.returncode == 130 or result.returncode == 143:
            return ActionResult(False, "这一轮被停下了，没有回复。", chat_id)
        if result.returncode != 0 or data.get("is_error") is True or (data and data.get("subtype") not in (None, "success")):
            # 🔴 原来连 stderr 原文一起发到手机（可能带本机路径）。原文只进日志（第 11 轮文案门禁）
            logger.warning("Cursor 没答上来 退出码=%s stderr=%s", result.returncode,
                           (result.stderr or "")[:500])
            detail = short_title(reply, 200) if reply else "它没说原因，再发一次试试"
            return ActionResult(False, f"Cursor 没答上来：{detail}", chat_id)
        if not reply.strip():
            return ActionResult(True, RELAY_EMPTY_REPLY, chat_id)
        return ActionResult(True, reply.strip(), chat_id)

    # ---------- worker-server ----------

    def _watch_workers(self, watch: _WorkerWatch) -> None:
        """发送期间：每隔一会儿看一眼我们那个进程的子孙里有没有 worker-server。"""
        while True:
            try:
                self._note_workers(watch, self._procs())
            except Exception:
                logger.exception("看 worker-server 时出错")
            if watch.stop.wait(self.worker_poll_sec):
                break
        try:  # 结束前再看最后一眼（它可能刚好在最后半秒里起来）
            self._note_workers(watch, self._procs())
        except Exception:
            pass

    @staticmethod
    def _note_workers(watch: _WorkerWatch, table: ProcTable) -> None:
        if not watch.pid or not watch.lstart or table.error:
            return
        if table.lstart(watch.pid) != watch.lstart:
            return  # 我们那个进程已经没了（或 pid 被复用），它名下的子孙认不准了
        family = {watch.pid}
        frontier = [watch.pid]
        while frontier:
            kids = [p for ppid in frontier for p in table.children(ppid) if p.pid not in family]
            family.update(p.pid for p in kids)
            frontier = [p.pid for p in kids]
            for proc in kids:
                if is_worker_server(proc.args) and proc.pid not in watch.seen:
                    watch.seen[proc.pid] = proc

    def _reap_workers(self, watch: _WorkerWatch, cwd: str) -> int:
        """只收证明是我们起的 worker：还是那个进程、cwd 对得上、启动不早于我们。拿不准就留着。"""
        if not watch.seen:
            return 0
        spawn_at = parse_lstart(watch.lstart)
        table = self._procs()
        if table.error:
            logger.info("读不到进程表，%d 个 worker-server 先留着", len(watch.seen))
            return 0
        candidates = []
        for pid, seen in watch.seen.items():
            if table.lstart(pid) != seen.lstart:
                continue  # 已经自己退了，或者 pid 被别人复用
            if not spawn_at or seen.started_at + 1 < spawn_at:
                logger.info("worker-server pid=%s 启动时间早于我们的进程，留着", pid)
                continue
            candidates.append(seen)
        if not candidates:
            return 0
        cwds = self._lsof_cwds([p.pid for p in candidates])
        if cwds is None:
            logger.info("lsof 读不到 cwd，%d 个 worker-server 先留着", len(candidates))
            return 0
        reaped = 0
        for proc in candidates:
            if not _same_dir(cwds.get(proc.pid, ""), cwd):
                logger.info("worker-server pid=%s 的 cwd 对不上（%s），留着", proc.pid, cwds.get(proc.pid, "?"))
                continue
            # 单独的 tool 名：登记的这一瞬间别的线程扫描时，不会把它当成一个对话列出来
            job = self.jobs.register(proc.pid, proc.lstart, WORKER_JOB_TOOL, str(watch.pid))
            if job is None:
                continue
            res = self.jobs.signal(proc.pid, _signal.SIGTERM)  # 唯一发信号的地方，lstart 再核一次
            self.jobs.forget(proc.pid)
            if res.ok:
                reaped += 1
                logger.info("收掉了我们起的 worker-server pid=%s", proc.pid)
            else:
                logger.info("worker-server pid=%s 没收掉：%s", proc.pid, res.text)
        return reaped
CARHER_PY_EOF

write_file "$APP_HOME/bridge/fleet/scan.py" <<'CARHER_PY_EOF'
"""一次扫描：三家并发列会话，每家独立超时，绝不抛异常。

`Fleet(adapters).overview()` → `Overview`：在跑的 + 最近的（跨三家），某家读失败 / 超时
就只少那一家，并在 `notes` 里留一句大白话。手机上的卡片只看这个结构。

🔴 超时的那一家**不等它**：线程池里的线程会自己跑完（adapter 里所有子进程都带 timeout），
但这次总览不带它的结果。所以这里不用 `with ThreadPoolExecutor()`（退出时会 join 等它）。
"""

from __future__ import annotations

import concurrent.futures as _cf
import logging
import threading
import time
from dataclasses import dataclass, field
from typing import Any, Optional

from .model import Session, friendly_error

logger = logging.getLogger("feishu-bridge.fleet")

TOOL_LABELS = {"claude": "Claude", "codex": "Codex", "cursor": "Cursor"}
DEFAULT_TIMEOUT_SEC = 1.2  # 本机实测三家各自 50~270ms；留余量但总览要 < 1.5 秒
# 每家读多少个历史会话（在跑 / 等你的另算，全读）。第 28 轮从 6 提到 30：总览「还有 N 个，点开看全部」
# 要真能列出来，读 6 个时 Codex / Cursor 那组点开也只有 6 行。本机实测三家读 30 个各 70~200ms，
# 在 DEFAULT_TIMEOUT_SEC 之内；总览卡本身每组仍只列 MAX_ROWS_PER_TOOL 行，卡不会变大。
RECENT_PER_TOOL = 30
# 🔴 2026-11-06：**「等你」排第一**，排在「在跑」前面。
# 原来是 running 在前、waiting 在后，而总览每组只列 8 行 ⇒ 实测 10 个在跑 + 2 个等你时，
# 列出来的 8 行全是 🟢，两个在等主人的会话被压进「还有 11 个更早的没列出来」里 ——
# 恰恰是主人掏出手机最想找的那一类（它卡住了、在等我点头）。在跑的不用他管，等他的才要他管。
_STATUS_RANK = {"waiting": 0, "running": 1, "idle": 2, "stopped": 3, "unknown": 4}


@dataclass
class Overview:
    sessions: list = field(default_factory=list)  # 全部（在跑的在前），跨三家
    notes: list = field(default_factory=list)  # 哪家读不到 / 超时，一家一句
    took_sec: float = 0.0
    at: float = 0.0
    # 这次**按时读完**的那几家（就算一个会话都没有）。总控据此决定替换哪几家的缓存。
    ok_tools: list = field(default_factory=list)

    def by_tool(self) -> dict:
        out: dict = {}
        for sess in self.sessions:
            out.setdefault(sess.tool, []).append(sess)
        return out

    @property
    def running(self) -> list:
        return [s for s in self.sessions if s.pids or s.status in ("running", "waiting")]

    def running_count(self) -> int:
        return len(self.running)


def _sort_key(sess: Session) -> tuple:
    live = bool(sess.pids) or sess.status in ("running", "waiting")
    return (not live, _STATUS_RANK.get(sess.status, 9), -(sess.updated_at or 0))


class Fleet:
    """把几家 adapter 拼成一个总控。`adapters`：tool → Adapter（或 Adapter 列表）。"""

    def __init__(self, adapters: Any, timeout: float = DEFAULT_TIMEOUT_SEC,
                 per_tool: int = RECENT_PER_TOOL) -> None:
        if isinstance(adapters, dict):
            items = list(adapters.items())
        else:
            items = [(getattr(a, "tool", ""), a) for a in adapters or ()]
        self.adapters = {tool: ad for tool, ad in items if tool}
        self.timeout = float(timeout)
        self.per_tool = int(per_tool)
        self._pool = _cf.ThreadPoolExecutor(max_workers=max(2, len(self.adapters) * 2),
                                            thread_name_prefix="fleet-scan")
        # 同一家上一次扫描还没回来（超时了还在跑）就不再叠一个：慢的那家不会越堆越多
        self._busy: set = set()
        self._busy_guard = threading.Lock()

    def adapter(self, tool: str) -> Optional[Any]:
        return self.adapters.get(tool)

    def _one(self, tool: str, adapter: Any, limit: int) -> tuple:
        try:
            sessions = list(adapter.list(limit) or [])
        except Exception as exc:  # adapter 约定不抛；万一抛了也只少这一家
            # 外面会拼成「Claude：…」，这里别再带一遍家名
            return [], friendly_error(exc, "这次没读出来", log_as=f"扫描 {tool} 失败")
        finally:
            with self._busy_guard:
                self._busy.discard(tool)
        note = str(getattr(adapter, "last_error", "") or "")
        return [s for s in sessions if isinstance(s, Session)], note

    def overview(self, limit: Optional[int] = None) -> Overview:
        started = time.monotonic()
        limit = self.per_tool if limit is None else int(limit)
        out = Overview(at=time.time())
        futures = {}
        for tool, adapter in self.adapters.items():
            with self._busy_guard:
                if tool in self._busy:
                    out.notes.append(f"{TOOL_LABELS.get(tool, tool)} 上一次还没读完，这次先跳过")
                    continue
                self._busy.add(tool)
            try:
                futures[tool] = self._pool.submit(self._one, tool, adapter, limit)
            except Exception as exc:  # 线程池关了之类
                with self._busy_guard:
                    self._busy.discard(tool)
                out.notes.append(friendly_error(exc, f"{TOOL_LABELS.get(tool, tool)} 没能开始读"))
        deadline = started + self.timeout
        for tool, fut in futures.items():
            label = TOOL_LABELS.get(tool, tool)
            try:
                sessions, note = fut.result(timeout=max(0.0, deadline - time.monotonic()))
            except _cf.TimeoutError:
                out.notes.append(f"{label} 读得太慢，这次没等它")
                continue
            except Exception as exc:
                out.notes.append(friendly_error(exc, f"{label} 没读出来"))
                continue
            out.sessions.extend(sessions)
            out.ok_tools.append(tool)
            if note:
                out.notes.append(f"{label}：{note}")
        out.sessions.sort(key=_sort_key)
        out.took_sec = time.monotonic() - started
        return out

    def running_count(self) -> Optional[int]:
        """电脑上开着几个会话（给 /status）。读不出返回 None。"""
        try:
            return self.overview().running_count()
        except Exception:
            return None
CARHER_PY_EOF

write_file "$APP_HOME/bridge/fleet/cards.py" <<'CARHER_PY_EOF'
"""会话总控的飞书卡片 + 按钮回调白名单。

卡片约束照 `bridge/menu.py`（踩过的）：schema 2.0、**没有** action 容器、按钮回调走
`behaviors: [{"type":"callback","value":{...}}]`，整张卡远小于 30KB（这里压到 < 20KB）。

回调只认 `{"act":"fleet","op":"open|send|go|stop|refresh|settle|unsettle","tool":...,"id":...}`、
`{"act":"fleet","op":"snooze","tool":...,"id":...,"q":<16 位十六进制>}`（推送卡上「1 小时后再提醒」）、
`{"act":"fleet","op":"more","tool":...}`（总览上展开一组，不带 id）和
`{"act":"relay","op":"talk|no",...}`（进对话模式的那次确认），
并且 (tool, id) 必须在**最近一次扫描结果**里出现过 —— 伪造的 id 进不来
（`resolve_fleet_click` / `resolve_relay_click`）。
"""

from __future__ import annotations

import json
import os
import time
import unicodedata
from typing import Any, Iterable, Optional

from ..reply import FENCE, card_snippet, escape_card, inline_code
from .actions import button_rows, detail_nav_rows, do_button, jump_callback_button
from .model import TOOLS, Session, short_title
from .scan import TOOL_LABELS, Overview

# `go`：详情卡上「接着聊」**已经跳进群**的那一下（按钮同时带 open_url，见 `build_detail_card` 的 group_link）。
# 和 send 走同一条路，只是单聊里不再补「➡️ 进群说话」。
# `more`：总览上「还有 N 个没列出来」那个按钮（第 28 轮）⇒ 原地换卡、把这一组全列出来。只带 tool，不带 id。
# `settle` / `unsettle`：详情卡上「✓ 结束」和结束后那张卡上的「撤销」（第 33 轮，`fleet/settled.py`）。
# `snooze`：「等你」推送卡上「1 小时后再提醒」（第 33 轮）。只有它可以多带一个 `q`（它在问什么的指纹）。
OPS = ("open", "send", "go", "stop", "refresh", "more", "settle", "unsettle", "snooze")
_SIG_MAX = 16
RELAY_OPS = ("talk", "no")  # 进对话模式那张确认卡：确认 / 算了
MAX_CARD_BYTES = 20 * 1024
# 一张卡最多 200 个组件（飞书官方文档）。「全部列出来」那一组可能有几十行 ⇒ 字节之外还得数组件。
MAX_CARD_COMPONENTS = 200
# 折叠面板标题右边那个小箭头（主会话 2026-11-08 真发过、飞书接受的写法）
PANEL_ICON = {"tag": "standard_icon", "token": "down-small-ccm_outlined", "size": "16px 16px"}
# 总览一个工具最多列几行。瘦身后一行只剩「状态点 + 名字 + 多久前」（旧的一行还带工具名和
# 项目名），同样的字节能多列几行 ⇒ 6 提到 8。再多手机上就要一直划了，而且更早的会话
# 本来也不是他要找的（底下有「还有 N 个更早的没列出来」）。
MAX_ROWS_PER_TOOL = 8
MSG_PREVIEW_CHARS = 600  # 每条消息最多显示多少字（代码块按原样保留换行，所以比原来的 300 宽一点）
MSG_PREVIEW_LINES = 16  # 再多行手机上一屏就满了
_ID_MAX = 128

STATUS_LABELS = {
    "running": "🟢 在跑",
    "waiting": "🟡 等你",
    "idle": "⚪ 闲着",
    "stopped": "⏸ 挂起",
    "unknown": "❔ 看不出",
}

# ---------- 卡片上显示的状态（第 32 轮，照 T3 手机列表）----------
#
# `Session.status` 是 adapter 读出来的「进程在干什么」；卡片上要的是「要不要我管、管什么」，
# 所以多分几种（`display_status`）。读不到的一律退回原来那几种，**不猜**：
# - 「等你」能读出它在问什么（`pending`）才拆成「等你批准 / 等你回答」，读不出就还是「🟡 等你」
# - 「出错了」只认 adapter 真读到的失败信号（`Session.last_turn == "failed"`）
# - 「跑完了你还没看」要知道上一次给这个人发总览卡是什么时候（`seen_at`）；不知道就不显示
DISPLAY_LABELS = {
    "approve": "🟡 等你批准",
    "ask": "❓ 等你回答",
    "waiting": "🟡 等你",
    "failed": "⚠️ 出错了",
    "running": "🟢 在跑",
    "unseen": "✅ 跑完了，你还没看",
    **{k: v for k, v in STATUS_LABELS.items() if k not in ("running", "waiting")},
}
# 排序：数字小的排前面。等你批准 > 等你回答 > 出错了 > 在跑 > 跑完没看 > 闲着（tasks-r32 第 4 条）。
# 读不出在问什么的「等你」跟「等你回答」并列（都是要他现在就管的）。
DISPLAY_RANK = {"approve": 0, "ask": 1, "waiting": 1, "failed": 2, "running": 3, "unseen": 4,
                "idle": 5, "stopped": 6, "unknown": 7}
# 要他管的（组要展开、标题要点数）
NEEDS_YOU = ("approve", "ask", "waiting", "failed", "running", "unseen")
# 点数时的说法（标题 / 折叠面板 / 「还有 N 个」按钮共用一份，别各写各的）
_COUNT_WORDS = {
    "approve": "个等你批准",
    "ask": "个等你回答",
    "waiting": "个在等你",
    "failed": "个出错了",
    "running": "个在跑",
    "unseen": "个跑完了你还没看",
}
# 「还有 N 个」按钮上一行只有 48 格 ⇒ 用短说法（只这一处用）
_SHORT_WORDS = dict(_COUNT_WORDS, unseen="个跑完没看")


# 「出错了」只标最近这么久之内的那一轮。本机实测 Claude 历史里有几天前测坏 key 留下的
# `authentication_failed` 收尾 —— 那种会话他早不管了，天天挂一个 ⚠️ 等于狼来了。
FAILED_FRESH_SEC = 24 * 3600


def display_status(sess: Session, seen_at: Optional[float] = None, now: Optional[float] = None) -> str:
    """一个会话在卡片上算哪种状态（`DISPLAY_LABELS` 的键）。

    `seen_at`：上一次给**这个人**发总览卡的时间（epoch 秒）；None ⇒ 不知道 ⇒ 不判「跑完没看」。
    """
    status = sess.status
    if status == "waiting":
        pending = getattr(sess, "pending", None)
        if pending is None:
            return "waiting"
        if pending.tool == "AskUserQuestion":
            return "ask"
        return "approve" if pending.tool else "waiting"
    if status != "idle":
        return status if status in DISPLAY_LABELS else "unknown"
    turn = getattr(sess, "last_turn", "")
    turn_at = getattr(sess, "last_turn_at", 0) or 0
    if turn == "failed":
        now = time.time() if now is None else now
        return "failed" if now - turn_at < FAILED_FRESH_SEC else "idle"
    if turn == "done" and seen_at and turn_at > float(seen_at):
        return "unseen"
    return "idle"


def display_label(sess: Session, seen_at: Optional[float] = None) -> str:
    return DISPLAY_LABELS[display_status(sess, seen_at)]


def sort_for_overview(sessions: list, seen_at: Optional[float] = None) -> list:
    """按 `DISPLAY_RANK` 排；同一档里保持原来的先后（扫描已经按活的在前、最近的在前排过）。"""
    return sorted(sessions or (), key=lambda s: DISPLAY_RANK.get(display_status(s, seen_at), 9))


def _count_parts(sessions: list, seen_at: Optional[float], kinds=NEEDS_YOU, bold: bool = False,
                 with_dot: bool = True, words: Optional[dict] = None) -> list:
    """「🟡 2 个等你批准」「⚠️ 1 个出错了」…… 按优先级排，没有的不写。"""
    counts: dict = {}
    for sess in sessions or ():
        kind = display_status(sess, seen_at)
        counts[kind] = counts.get(kind, 0) + 1
    out = []
    for kind in sorted(kinds, key=lambda k: DISPLAY_RANK[k]):
        n = counts.get(kind, 0)
        if not n:
            continue
        text = f"{n} {(words or _COUNT_WORDS)[kind]}"
        if bold:
            text = f"**{text}**"
        if with_dot:
            text = DISPLAY_LABELS[kind].split(" ", 1)[0] + " " + text
        out.append(text)
    return out


class OverviewSeen:
    """「上一次给这个人发总览卡是什么时候」—— 只记在内存（tasks-r32：记不到就不显示，不要猜）。

    桥重启就清空 ⇒ 重启后第一张总览不会有「跑完没看」，第二张起才有。
    `viewer` 用发卡的那个 chat_id（单聊就是这个人）。记的是**那次扫描的时间**（`Overview.at`）：
    扫描之后才结束的那一轮，那张卡上本来就没有它。

    用法（app.py 那边）：
        seen = OVERVIEW_SEEN.before(chat_id, view.at)        # 造卡前：这张卡之前的那一次
        card = build_overview_card(view, ..., seen_at=seen)
        …发出去之后… OVERVIEW_SEEN.mark(chat_id, view.at)
    「看全部」原地换卡用的是同一次扫描（`control.last`）⇒ `before(chat_id, last.at)` 拿到的还是
    造原卡时那个值，换出来的卡上「跑完没看」不会因为刚发过一次就全没了。
    """

    KEEP = 4  # 每个人留最近几次；「看全部」只会回头找上一张

    def __init__(self) -> None:
        import threading

        self._lock = threading.Lock()
        self._marks: dict = {}

    def before(self, viewer: str, at: Any = None) -> Optional[float]:
        """严格早于 `at` 的最近一次发卡时间；`at` 不给 = 最近一次。一次都没记过 ⇒ None。"""
        if not viewer:
            return None
        try:
            limit = float(at) if at else float("inf")
        except (TypeError, ValueError):
            limit = float("inf")
        with self._lock:
            marks = [m for m in self._marks.get(str(viewer), ()) if m < limit]
        return max(marks) if marks else None

    def mark(self, viewer: str, at: Any) -> None:
        try:
            at = float(at or 0)
        except (TypeError, ValueError):
            return
        if not viewer or not at > 0:
            return
        with self._lock:
            marks = sorted(set(self._marks.get(str(viewer), ())) | {at})[-self.KEEP:]
            self._marks[str(viewer)] = marks


OVERVIEW_SEEN = OverviewSeen()
# 桥只给主人一个人发总览（`owner_open_ids`）⇒ 不传 `viewer` 时都记在这一个键上
OWNER_VIEWER = "owner"
_AUTO = object()
SURFACE_LABELS = {"cli": "终端", "app": "App", "bridge": "飞书"}
ROLE_LABELS = {"user": "🙋 你", "assistant": "🤖 它"}


def fleet_value(op: str, tool: str = "", sid: str = "") -> dict:
    value = {"act": "fleet", "op": op}
    if tool:
        value["tool"] = tool
    if sid:
        value["id"] = sid
    return value


def resolve_fleet_click(value: Any, known: Iterable[tuple]) -> Optional[dict]:
    """回调 value → {"op","tool","id"}；不认识 / id 不在最近一次扫描里 ⇒ None。

    🔴 白名单思路同 `menu.resolve_click`：value 来自飞书，理论上能伪造。只放预设的 op、
    已知的 tool、在扫描结果里出现过的 id；多余的键一律不认（不许夹带 text 之类）。
    """
    if not isinstance(value, dict) or value.get("act") != "fleet":
        return None
    op = value.get("op")
    allowed = {"act", "op", "tool", "id"} | ({"q"} if op == "snooze" else set())
    if set(value) - allowed:
        return None
    if op not in OPS:
        return None
    sig = value.get("q", "")
    if op == "snooze" and not (isinstance(sig, str) and len(sig) <= _SIG_MAX
                               and all(c in "0123456789abcdef" for c in sig)):
        return None
    if op == "more":
        # 「展开这一组」：只认 act/op/tool 三个键、tool 必须是已知的那几家；带 id 的一律不认
        tool = value.get("tool")
        if set(value) != {"act", "op", "tool"} or not isinstance(tool, str) or tool not in TOOLS:
            return None
        return {"op": "more", "tool": tool, "id": ""}
    if op == "refresh" and "id" not in value and "tool" not in value:
        return {"op": "refresh", "tool": "", "id": ""}
    tool, sid = value.get("tool"), value.get("id")
    if not isinstance(tool, str) or tool not in TOOLS:
        return None
    if not isinstance(sid, str) or not sid or len(sid) > _ID_MAX:
        return None
    if (tool, sid) not in set(known):
        return None
    if op == "snooze":
        return {"op": op, "tool": tool, "id": sid, "q": sig}
    return {"op": op, "tool": tool, "id": sid}


def relay_value(op: str, tool: str = "", sid: str = "") -> dict:
    """进对话模式那张确认卡上的按钮。独立的 `act` ⇒ 不会和 `fleet` 的 op 混。"""
    return {"act": "relay", "op": op, "tool": tool, "id": sid}


def resolve_relay_click(value: Any, known: Iterable[tuple]) -> Optional[dict]:
    """确认卡回调 → {"op","tool","id"}；不认识 ⇒ None。

    🔴 白名单同 `resolve_fleet_click`：value 来自飞书、理论上能伪造，而这张卡点一下的
    后果是「让电脑上那个会话不问就动手」。所以 op 只认预设两个、id 必须在最近一次扫描里。
    """
    if not isinstance(value, dict) or value.get("act") != "relay":
        return None
    if set(value) - {"act", "op", "tool", "id"}:
        return None
    op = value.get("op")
    if op not in RELAY_OPS:
        return None
    tool, sid = value.get("tool"), value.get("id")
    if not isinstance(tool, str) or tool not in TOOLS:
        return None
    if not isinstance(sid, str) or not sid or len(sid) > _ID_MAX:
        return None
    if (tool, sid) not in set(known):
        return None
    return {"op": op, "tool": tool, "id": sid}


def _button(label: str, value: dict, primary: bool = False) -> dict:
    return {
        "tag": "button",
        "text": {"tag": "plain_text", "content": label},
        "type": "primary" if primary else "default",
        "width": "fill",
        "size": "medium",
        "behaviors": [{"type": "callback", "value": value}],
    }


def _row(buttons: list) -> dict:
    return {
        "tag": "column_set",
        "horizontal_spacing": "8px",
        "columns": [
            {"tag": "column", "width": "weighted", "weight": 1, "elements": [b]} for b in buttons
        ],
    }


def _md(text: str, small: bool = False) -> dict:
    node = {"tag": "markdown", "content": text}
    if small:
        node["text_size"] = "notation"
    return node


def _escape(text: str) -> str:
    """卡片 markdown 里别让会话标题 / 消息变成格式、标签或链接。

    🔴 用 HTML 实体（`&#60;`），不用反斜杠：飞书卡片文档（JSON 2.0 富文本组件，2026-11-05 查）
    给的转义办法只有实体这一种，反斜杠转义没写支持 —— 显示出来可能就是 `\\*`。
    """
    return escape_card(text)


def message_md(who: str, text: str, chars: int = MSG_PREVIEW_CHARS, lines: int = MSG_PREVIEW_LINES) -> str:
    """详情卡里的一条消息：代码块保留成代码块，其余文字转义（粗体和行内代码照常显示）。

    🔴 `text` 必须是**已经整段脱敏过**的（见 `build_detail_card` 的红字）。这里排版 → 截断 → 转义，
    截在代码块中间也会补上收尾的 ```（不然后面的消息和按钮整张卡都被染成代码）。
    原来用 `short_title` 把换行压成一行，代码全糊成一坨。
    """
    body = card_snippet(text, chars, lines) if text.strip() else "（空）"
    # 代码块的 ``` 必须在行首（卡片文档原话）⇒ 一开头就是代码块时「谁：」单独一行
    sep = "\n" if body.startswith(FENCE) else ""
    return f"{who}：{sep}{body}"


def project_of(cwd: str) -> str:
    if not cwd:
        return "不知道哪个项目"
    return os.path.basename(cwd.rstrip("/\\")) or cwd


# ---------- 一行能放多少字 ----------

# 手机竖屏一行看得见的宽度，按**半角格**算：一个汉字 2 格 ⇒ 48 格 = 24 个汉字。
# 用户原话「文字太多 手机上显示不全」—— 原来一行是「工具 · 项目 · 状态 · 多久前｜标题」，
# 实测 40 格开头、带长标题的到 60 格，后半截在手机上直接看不见。
# 🔴 这个数是**可见宽度**不是字符数：`slot-allocation-aimd` 20 个字母只占 20 格，
# 原来按字符数截（18 个）把它截成了 `slot-allocation-a…`，白白浪费半行。
OVERVIEW_ROW_CELLS = 48
# 名字最少留这么多格（5 个汉字）：项目名 + 多久前再长也不能把名字挤没了
NAME_FLOOR_CELLS = 10
# 名字**先拿够**这么多格（10 个汉字），项目名只分剩下的。
#
# 🔴 2026-11-05 体验审查：原来项目名先拿满 14 格，名字拿剩下的 ⇒ 不在主项目的那几行，
# 名字被剪到 7 个汉字（实测 `⚪ 生成一个视频：… · oneline-video · 2 分钟前`）。
# 用户是按**名字**找会话的 —— 工具名和项目已经在分组标题上说过一遍了，
# 行里的项目名只是「这行跟标题那个项目不一样」的提示，不该比名字先吃饱。
NAME_TARGET_CELLS = 20
SEP = " · "  # 行里各段之间的分隔。宽度由 `display_width` 现算，别写死数字（见下面红字）
# 文字兜底那条路（卡片发不出去时的纯文字消息）一行的预算。比卡片宽：**纯文字消息会自己折行**，
# 超出屏宽只是换一行，不像按钮那样后半截直接看不见。所以那边不必为了一屏把名字削掉。
FALLBACK_ROW_CELLS = 72
# 行里补的项目名（和分组标题不是同一个项目时）最多占几格
ROW_PROJECT_CELLS = 14
# 行里「不知道是哪个项目」的短说法。
# 🔴 整句「不知道哪个项目」占 14 格 —— 在一行只有 48 格、名字要先拿够的时候，
# 它会被剪成「不知道…」（说了等于没说，还白占 6 格）。行里的项目名只是个提示 ⇒ 用短的。
# 详情卡和文字兜底那条路不受影响，那边地方够，照旧用整句。
ROW_NO_PROJECT = "项目不明"
HEADING_PROJECT_CELLS = 24  # 分组标题里的项目名最多占几格
# 名字撞车时补的短 id 长度。uuid 前 4 位撞车的概率可以忽略，撞了两行拿到同一个尾巴，
# 也比两行一模一样强。
DUP_ID_CHARS = 4
# 每条「哪家读不到」说明最多显示多少字。🔴 `_fit` 只会少放会话行、不会剪说明 ⇒ 一条超长的
# 报错原文（比如 adapter 把整段 stderr 塞进 last_error）能让卡片永远超 20KB、只剩 1 行也下不来。
NOTE_CHARS = 160


def _cluster_width(cluster: str) -> int:
    """一个「看起来是一个字」的东西占几格。"""
    base = cluster[0]
    # emoji / 符号（🟢 ⏸ ❔ 国旗的区域指示符都在这里）：手机上都当两格算
    if unicodedata.category(base) in ("So", "Sk"):
        return 2
    return 2 if unicodedata.east_asian_width(base) in ("W", "F", "A") else 1


def _graphemes(text: str) -> list:
    """按「一个字」切开，**不切到 emoji 中间**。

    🔴 会话名是用户项目里的文字，里面可能有 emoji。`👨‍👩‍👧‍👦` 是 7 个码位拼出来的一个字，
    按码位截会留下半截 ZWJ ⇒ 手机上显示成一串碎人头，或者干脆是方块。
    这里把「组合符号 / 变体选择符 / 肤色 / ZWJ 连起来的」都粘回前一个字。
    """
    out: list = []
    join_next = False
    for ch in text:
        code = ord(ch)
        glue = join_next or (
            code == 0x200D  # ZWJ 自己也粘前面（它是 Cf 不是 Mn，漏了实测一家四口算成 5 格、还能被剪开）
            or unicodedata.category(ch) in ("Mn", "Mc", "Me")  # 组合符号、藏文元音之类
            or 0xFE00 <= code <= 0xFE0F  # 变体选择符（VS16 = 让符号按 emoji 显示）
            or 0xE0100 <= code <= 0xE01EF
            or 0xE0020 <= code <= 0xE007F  # 旗帜的 tag 序列（🏴󠁧󠁢󠁳󠁣󠁴󠁿）
            or 0x1F3FB <= code <= 0x1F3FF  # 肤色
            or code == 0x20E3  # 键帽（1️⃣）
            or (out and 0x1F1E6 <= code <= 0x1F1FF and len(out[-1]) == 1
                and 0x1F1E6 <= ord(out[-1]) <= 0x1F1FF)  # 国旗 = 两个区域指示符
        )
        join_next = ch == "‍"  # ZWJ：它自己粘前面，后面那个也粘上来
        if glue and out:
            out[-1] += ch
        else:
            out.append(ch)
    return out


def display_width(text: Any) -> int:
    """一段文字在手机上占几格（汉字 / emoji 算 2，字母数字算 1）。"""
    return sum(_cluster_width(g) for g in _graphemes(str(text or "")))


def clip_cells(text: Any, cells: int) -> str:
    """压成一行、按**可见宽度**截断、超了加「…」。`cells` 是半角格数。"""
    flat = " ".join(str(text or "").split())
    if cells <= 0:
        return ""
    if display_width(flat) <= cells:
        return flat
    budget = cells - 2  # 「…」自己占两格
    out: list = []
    used = 0
    for g in _graphemes(flat):
        wide = _cluster_width(g)
        if used + wide > budget:
            break
        out.append(g)
        used += wide
    return "".join(out).rstrip() + "…"


# ---------- 总览的行和分组标题 ----------


def status_dot(sess: Session, seen_at: Optional[float] = None) -> str:
    """状态只留那个点（「在跑 / 闲着」那两个字挪到卡片底下的图例里，一行省 6 格）。"""
    return display_label(sess, seen_at).split(" ", 1)[0]


def session_name(sess: Session, cells: int = OVERVIEW_ROW_CELLS) -> str:
    """会话名：没标题的用短 id 兜着，绝不返回空串（空按钮点不着也看不懂）。

    `sess.title` 必须是**已经整段脱敏过**的（调用方先过 `_cleaned`，见 `build_detail_card` 的红字）。
    """
    name = clip_cells(sess.title, cells)
    if name:
        return name
    sid = str(sess.id or "")
    return sid[:8] or "没名字的会话"


def _row_parts(sess: Session, shared_project: str, dup_tag: str,
               cells: int = OVERVIEW_ROW_CELLS, seen_at: Optional[float] = None) -> tuple:
    """(状态点, 名字, 后面那几段)。只给卡片那种样子用。

    格子怎么分（🔴 **名字优先**，2026-11-05 体验审查改的）：
    1. 状态点、`#短 id`、多久前 这几样先占位 —— 它们都短且固定，而且少了会分不清哪行是哪行
    2. 名字拿到 `NAME_TARGET_CELLS` 为止（够放 10 个汉字）
    3. 剩下的才归项目名；不够放 `不知道哪个项目` 那么宽也没关系，它只是个提示
    4. 项目名剪完还有富余 ⇒ 全给名字（短项目名的行名字能更长）
    """
    head = status_dot(sess, seen_at)
    project = project_of(sess.cwd)
    show_project = bool(project and project != shared_project)
    if show_project and not sess.cwd:
        project = ROW_NO_PROJECT  # 见 ROW_NO_PROJECT 的红字
    # 短且必须显示的那几段
    fixed: list = []
    if dup_tag:
        fixed.append("#" + dup_tag)
    if sess.age_text:
        fixed.append(sess.age_text)
    # 🔴 分隔符的宽度要**现算**：`·` 是 East-Asian-Ambiguous，按两格算 ⇒ ` · ` 是 4 格不是 3。
    # 写死 3 的话每段都少留一格，整行算下来没超、拼出来超了 ⇒ `clip_cells` 再剪一刀，
    # 名字尾巴被砍成 `198 的 litel…`（实测）。
    sep = display_width(SEP)
    used = display_width(head) + 1 + sum(display_width(t) + sep for t in fixed)
    room = cells - used
    tail: list = []
    if show_project:
        # 名字先拿够（但不超过它真的需要的宽度），项目名分剩下的
        want = min(NAME_TARGET_CELLS, display_width(sess.title or "") or NAME_TARGET_CELLS)
        for_project = max(0, room - max(NAME_FLOOR_CELLS, want) - sep)
        shown = clip_cells(project, min(ROW_PROJECT_CELLS, for_project))
        if shown:
            tail.append(shown)
            room -= display_width(shown) + sep
    name = session_name(sess, max(NAME_FLOOR_CELLS, room))
    return head, name, tail + fixed


def _standalone_label(sess: Session, cells: int, seen_at: Optional[float] = None) -> str:
    """一行自己说清楚：「工具 · 项目 · 状态 · 多久前｜标题」（文字兜底用，没有分组标题和图例兜着）。

    🔴 状态写成字（「闲着」）不写成点：纯文字消息底下没有图例，光一个 `⚪` 认不出来。
    """
    bits = [TOOL_LABELS.get(sess.tool, sess.tool), project_of(sess.cwd),
            display_label(sess, seen_at).split(" ", 1)[-1]]
    if sess.age_text:
        bits.append(sess.age_text)
    label = SEP.join(bits)
    room = max(NAME_FLOOR_CELLS, cells - display_width(label) - 2)  # 2 = 「｜」
    label += "｜" + session_name(sess, room)
    return clip_cells(label, cells)


def row_label(sess: Session, *, shared_project: str = "", with_tool: bool = True,
              dup_tag: str = "", cells: int = 0, seen_at: Optional[float] = None) -> str:
    """总览里的一行。

    `with_tool=False` + `shared_project`：工具名和项目已经在分组标题上了 ⇒ 行里只留
    **不一样的那几样**：状态点 + 会话名 + 多久前，例 `🟢 修登录 · 3 分钟前`。
    这个会话的项目和标题上那个不一样时，才在名字后面补一个项目名。

    不传这两个参数就是「一行自己说清楚」的样子（带工具名和项目），给卡片发不出去时的
    文字兜底用 —— 那边没有分组标题兜着，只剩一个点和一个名字就看不出是哪个工具的了。

    `dup_tag`：同一组里名字撞车时补的短 id。
    `cells`：这一行最多几格；不传按上面两种样子各自的默认（卡片 48，文字兜底 72）。
    """
    if with_tool:
        return _standalone_label(sess, cells or FALLBACK_ROW_CELLS, seen_at)
    cells = cells or OVERVIEW_ROW_CELLS
    head, name, tail = _row_parts(sess, shared_project, dup_tag, cells, seen_at)
    label = SEP.join([f"{head} {name}"] + tail)
    # 兜底再剪一刀：名字有下限 ⇒ 项目名 / 多久前特别长时整行可能超，超了宁可丢尾巴
    return clip_cells(label, cells)


def row_names(sessions: list, shared_project: str = "", seen_at: Optional[float] = None) -> list:
    """这几行**真正会显示出来**的名字（已按行宽截断）。给撞车检测用。

    🔴 必须用截断后的名字去比：`proxy-ip-binding-admin` 和 `proxy-ip-binding-dev`
    原文不一样，截到一行里都是 `proxy-ip-binding-…`，比原文就看不出撞车。
    比的是**没补短 id 时**的名字：补了 id 名字会再短一点，但每行尾巴已经不一样了。
    """
    return [_row_parts(s, shared_project, "", seen_at=seen_at)[1] for s in sessions or ()]


def dup_tags(sessions: list, names: list) -> list:
    """同一组里显示出来一样的名字 ⇒ 每个都补一截短 id。

    实测 Cursor 里有三个会话都叫 `Chick eating rice video`，三行长得一模一样；
    加上长标题被截断之后撞车的，不补 id 根本点不准要哪个。
    """
    seen: dict = {}
    for name in names:
        seen[name] = seen.get(name, 0) + 1
    return [str(s.id or "")[:DUP_ID_CHARS] if seen.get(n, 0) > 1 else ""
            for s, n in zip(sessions or (), names or ())]


def main_project(sessions: list) -> str:
    """列出来的这几行里最多的那个项目。标题和行里**必须用同一份答案** ⇒ 只有这一个实现。"""
    projects = [project_of(s.cwd) for s in sessions or ()]
    if not projects:
        return ""
    # 并列最多时取先出现的那个（`set` 的顺序不稳，不能直接拿它决定显示什么）
    return max(sorted(set(projects), key=projects.index), key=projects.count)


def group_heading(tool: str, items: list, shown: list, clean=None) -> str:
    """分组标题：把一组里**一样的那几样**（工具名、项目）提到这里来。

    例 `🤖 **Claude** · carher-admin（6 个）`。一个工具跨几个项目时写成
    `carher-admin 等 3 个项目` —— 不再按项目切一层：切完「在跑的排最前」就被打散了，
    而标题行还会多出好几行。跟标题不是同一个项目的行，自己带项目名（见 `row_label`）。

    🔴 「等 N 个项目」只数**列出来的那几行**（2026-11-05 体验审查）：原来数的是 `items`
    全部，于是 8 行全在 carher-admin、更早的 6 个在别处时，标题写「等 7 个项目」而
    屏幕上一个别的项目都看不见。这句话的作用是解释「为什么有的行后面带项目名」——
    数没显示的行等于凭空制造一个找不到出处的数字。没列出来的那些有「还有 N 个更早的」兜着。
    """
    clean = clean or (lambda s: s)
    label = TOOL_LABELS.get(tool, tool)
    rows = shown or items
    main = main_project(rows)
    bits = [f"🤖 **{escape_card(label)}**"]
    text = clip_cells(_safe_clean(clean, main), HEADING_PROJECT_CELLS) if main else ""
    if text:  # 脱敏失败 ⇒ 空串 ⇒ 不写项目，别留一个「 · （1 个）」
        kinds = len({project_of(s.cwd) for s in rows})
        if kinds > 1:
            text += f" 等 {kinds} 个项目"
        # 先剪再转义：反过来会把 `&#60;` 这种实体剪成半截
        bits.append(escape_card(text))
    return SEP.join(bits) + f"（{len(items)} 个）"


def _live(sess: Session) -> bool:
    return bool(sess.pids) or sess.status in ("running", "waiting")


# 标题里加粗的那几种：要他**现在**就动手的
_URGENT = ("approve", "ask", "waiting")


def overview_headline(sessions: list, seen_at: Optional[float] = None) -> str:
    """总览第一句。🔴 先说「几个在等你」—— 那是主人掏出手机最想知道的。

    原来是「电脑上现在开着 **19** 个会话」：分不出几个在干活、几个卡住、几个在等他点头
    （2026-11-06 UX 侦察）。手机上几秒钟扫一眼，要的是**要不要我管**。

    第 32 轮：按 `DISPLAY_RANK` 点数（等你批准 > 等你回答 > 出错了 > 在跑 > 跑完没看），
    要他现在动手的那几种加粗。「出错了」「跑完没看」可能是没开着的历史会话，照样点数 ——
    那正是他要知道的。剩下开着但闲着的写「N 个开着闲着」；其余闲着的不进标题（噪音）。
    """
    sessions = list(sessions or ())
    kinds = [display_status(s, seen_at) for s in sessions]
    urgent = _count_parts([s for s, k in zip(sessions, kinds) if k in _URGENT], seen_at, bold=True)
    rest_parts = _count_parts([s for s, k in zip(sessions, kinds) if k not in _URGENT], seen_at)
    idle_live = sum(1 for s, k in zip(sessions, kinds) if k not in NEEDS_YOU and _live(s))
    parts = urgent + rest_parts
    if idle_live:
        parts.append(f"{idle_live} 个开着闲着")
    if not parts:
        return "电脑上现在没有开着的会话。"
    return "，".join(parts) + "。"


def overview_fallback_lines(sessions: list, clean=None, seen_at: Optional[float] = None,
                            limit: int = 12) -> list:
    """卡片发不出去时那条纯文字消息的行（给 app.py 的 `_fleet_overview` 用）。

    和卡片同一套：按 `DISPLAY_RANK` 排、状态**写成字**（`row_label` 的独立样子，底下没有图例）、
    等你的紧跟一句它在问什么（`overview_pending_line`）。标题先整段脱敏再截断（`_cleaned`）。
    """
    clean = clean or (lambda s: s)
    lines: list = []
    for sess in sort_for_overview(sessions, seen_at)[:limit]:
        cleaned = _cleaned(sess, clean)
        lines.append(row_label(cleaned, seen_at=seen_at))
        asking = overview_pending_line(cleaned, clean)
        if asking:
            lines.append("  " + asking)
    return lines


def _hidden_extra(hidden: list, seen_at: Optional[float], short: bool = False) -> list:
    """藏起来的那几个里要他管的：「2 个等你批准」「1 个出错了」…（不带点，按优先级）。"""
    return _count_parts(hidden, seen_at, with_dot=False, words=_SHORT_WORDS if short else None)


def hidden_rows_note(hidden: list, seen_at: Optional[float] = None) -> str:
    """「还有 N 个没列出来」—— 🔴 要照实说里面有什么，别一律叫「更早的」。

    原来写死「还有 11 个更早的没列出来」，实测那 11 个里有 2 个在跑、2 个在等你
    （2026-11-06 UX 侦察）。现在「等你」已经排到最前，一般不会被藏；但组里「等你」多于
    一屏能列的行数时，照样可能有藏着的 —— 那时这一句必须点名。
    """
    extra = _hidden_extra(hidden, seen_at)
    if extra:
        return f"⚠️ 还有 {len(hidden)} 个没列出来（其中 {'，'.join(extra)}），在电脑上看"
    return f"还有 {len(hidden)} 个更早的没列出来"


def status_legend(sessions: list, seen_at: Optional[float] = None) -> str:
    """卡片底下那行图例：只写**这张卡上出现过的**状态，没出现的不占地方；按优先级排。"""
    kinds = {display_status(s, seen_at) for s in sessions or ()}
    return SEP.join(DISPLAY_LABELS[k] for k in sorted(kinds, key=lambda k: DISPLAY_RANK.get(k, 9)))


def _safe_clean(clean, text: str) -> str:
    """脱敏失败不能让整张卡出不来（同 `_cleaned` 的兜底思路）。"""
    try:
        return clean(text or "")
    except Exception:  # noqa: BLE001
        return ""


def session_label(sess_or_target: Any, clean=None) -> str:
    """「Claude「修登录」」这种一眼能认的名字。给指示器和确认卡用。

    会话标题是**用户项目里的文字**（第一句话 / AI 起的标题），所以要过脱敏再截断
    （顺序见 `build_detail_card` 的红字）。
    """
    clean = clean or (lambda s: s)
    tool = getattr(sess_or_target, "tool", "")
    title = getattr(sess_or_target, "title", "") or ""
    sid = str(getattr(sess_or_target, "id", "") or "")
    name = short_title(clean(title), 24) if title else sid[:8]
    return f"{TOOL_LABELS.get(tool, tool)}「{name or sid[:8]}」"


# 对话模式的指示器。spec：对话模式中卡片/消息要**一直显示**「正在和 X 说话，退出发 /cancel」。
# 一句话里要同时有「在和谁」和「怎么退出」—— 少了后者，用户想停下时只能猜。
TALKING_PREFIX = "🗣 正在和"
# 🔴 11-05 用户原话「不要让用户输入 /cancel」⇒ 指示器里不再叫人打字，退出口是下面那排
# 「🚪 退出对话」按钮（bridge/fleet/actions.py）；`/cancel`、「取消」照样能用（兜底）。
TALKING_SUFFIX = "说话，你发的每一句都进它那边；要退出就点「退出对话」。"


def talking_banner(sess_or_target: Any, clean=None) -> str:
    return f"{TALKING_PREFIX} **{_escape(session_label(sess_or_target, clean))}** {TALKING_SUFFIX}"


def build_confirm_relay_card(sess_or_target: Any, redact=None) -> str:
    """进对话模式前的那**一次**确认（样式仿 `menu.build_confirm_loosen_card`）。

    🔴 为什么非要问一次：对话模式里用户打的每句话都由**电脑上那个会话**去做，用的是
    他在电脑上给它的那套权限（实测 21 个终端会话全是「跳过确认」）。手机这边的 `/mode`
    只读、审批卡片**一条都管不到它**。这和桥自己跑一轮是两件事，而误点的后果是
    「它不问你就动手」且**用户不会收到任何提示** —— 和放开权限那张卡同一个道理。

    确认过的会话 24 小时内不再问（`consent.RelayConsent`），不然连续多轮每句弹一张卡。
    """
    clean = redact or (lambda s: s)
    label = _escape(session_label(sess_or_target, clean))
    tool = getattr(sess_or_target, "tool", "")
    sid = str(getattr(sess_or_target, "id", "") or "")
    where = "电脑终端里" if TOOL_LABELS.get(tool) == "Claude" else "电脑上"
    elements = [
        _md(
            f"接下来你说的每一句都**直接进{where}那个会话**（{label}），由它去做。\n\n"
            "· 它的权限就是你在电脑上给它的那套 —— 多半是**不问你就改**\n"
            "· 手机这边的「只读」和确认卡片**管不到它**\n"
            "· 它干完会把文字回复转回这里；要停它手里那一轮，只能到电脑上按 Esc"
        ),
        _row([
            _button("确认，开始说话", relay_value("talk", tool, sid), primary=True),
            _button("算了", relay_value("no", tool, sid)),
        ]),
        _md("确认一次，这个会话 24 小时内不再问。进去之后每条回复下面都有「退出对话」。", small=True),
    ]
    return _card("⚠️ 直接跟电脑上那个会话说话", "orange", elements)


def _card(title: str, template: str, elements: list) -> str:
    return json.dumps(
        {
            "schema": "2.0",
            "config": {"wide_screen_mode": True},
            "header": {"title": {"tag": "plain_text", "content": title}, "template": template},
            "body": {"elements": elements},
        },
        ensure_ascii=False,
    )


# 不算组件的那几种 `tag`：按钮 / 标题里的文字对象、图标 —— 它们是组件的属性，不是组件
_NOT_COMPONENTS = {"plain_text", "lark_md", "standard_icon", "custom_icon"}


def _components(node: Any) -> int:
    """一张卡里有几个组件（带 `tag` 的 dict，文字对象和图标不算；面板标题那个 markdown 算上，宁多勿少）。"""
    if isinstance(node, dict):
        mine = 1 if "tag" in node and node.get("tag") not in _NOT_COMPONENTS else 0
        return mine + sum(_components(v) for v in node.values())
    if isinstance(node, list):
        return sum(_components(v) for v in node)
    return 0


def _fits(blob: str) -> bool:
    """放得下 = 不超 20KB，而且组件数不超飞书的上限（「全部列出来」那一组几十行时才会碰到）。"""
    if len(blob.encode("utf-8")) > MAX_CARD_BYTES:
        return False
    try:
        return _components(json.loads(blob)) <= MAX_CARD_COMPONENTS
    except ValueError:
        return False


def _fit(build, rows: int) -> str:
    """超了 20KB（或组件太多）就少放几行，直到放得下。"""
    blob = build(rows)
    while not _fits(blob) and rows > 1:
        rows -= 1
        blob = build(rows)
    return blob


def _cleaned(sess: Session, clean) -> Session:
    """标题先整段脱敏，再交给截断逻辑。Session 是 frozen 的 ⇒ 复制一份。"""
    import dataclasses

    try:
        return dataclasses.replace(sess, title=clean(sess.title or ""))
    except Exception:  # noqa: BLE001 —— 脱敏失败宁可不显示标题
        return dataclasses.replace(sess, title="")


def _busy(sess: Session, seen_at: Optional[float] = None) -> bool:
    """这一组要不要默认展开：等你批准 / 等你回答 / 出错了 / 在跑 / 跑完没看 ⇒ 展开；
    闲着 / 挂起 / 看不出 ⇒ 收起（第 28 轮用户原话；第 32 轮加了后三种）。"""
    return display_status(sess, seen_at) in NEEDS_YOU


_ALL_SAME = {"idle": "都闲着", "stopped": "都挂起了", "unknown": "都看不出在干什么"}


def group_summary(items: list, seen_at: Optional[float] = None) -> str:
    """折叠面板标题末尾那一截：收起时一眼看出这组要不要管。

    有要他管的 ⇒ 照实点数（按 `DISPLAY_RANK`，同 `overview_headline`）；
    一个都没有 ⇒「都闲着」「都挂起了」，混着几种 ⇒「没有在跑的」。数的是**整组**，不只是列出来的那几行。
    """
    parts = _count_parts(items, seen_at)
    if parts:
        return "，".join(parts)
    kinds = {display_status(s, seen_at) for s in items}
    if len(kinds) == 1:
        return _ALL_SAME.get(next(iter(kinds)), "没有在跑的")
    return "没有在跑的"


def panel_title(tool: str, items: list, shown: list, clean=None, seen_at: Optional[float] = None) -> str:
    """例「🤖 **Claude** · carher-admin（6 个）· 🟢 1 个在跑」。前半截就是原来的 `group_heading`。"""
    return f"{group_heading(tool, items, shown, clean)}· {group_summary(items, seen_at)}"


def more_button_label(hidden: list, seen_at: Optional[float] = None) -> str:
    """「还有 N 个没列出来」那个按钮（第 28 轮：原来是一句死字，点了没用）。藏着要他管的照样点名。"""
    extra = _hidden_extra(hidden, seen_at, short=True)
    # 🔴 按钮上的字手机竖屏一行放得下（≤ 48 格）：藏着要他管的那种写短一点（「其中」「没列出来」省掉），
    # 还超就从优先级低的那头一截截丢 —— 「点开看全部」不能被剪掉，那是这个按钮是干什么的。
    if extra:
        for n in range(len(extra), 0, -1):
            bits = extra[:n]
            label = f"⚠️ 还有 {len(hidden)} 个（{'，'.join(bits)}），点开看全部"
            if display_width(label) <= OVERVIEW_ROW_CELLS:
                return label
        return f"⚠️ 还有 {len(hidden)} 个，点开看全部"
    return f"还有 {len(hidden)} 个更早的没列出来，点开看全部"


def overflow_note(hidden: list, seen_at: Optional[float] = None) -> str:
    """点了「看全部」之后**还是**放不下的那几个（卡片 20KB / 200 个组件）。这里只能叫他回电脑上看。"""
    extra = _hidden_extra(hidden, seen_at)
    what = f"（其中 {'，'.join(extra)}）" if extra else ""
    return f"{'⚠️ ' if extra else ''}还有 {len(hidden)} 个这张卡放不下{what}，在电脑上看"


def _panel(title: str, expanded: bool, elements: list) -> dict:
    """折叠面板：客户端本地展开 / 收起，不走回调（字段照主会话 2026-11-08 真发通过的那张）。"""
    return {
        "tag": "collapsible_panel",
        "expanded": bool(expanded),
        "header": {
            "title": {"tag": "markdown", "content": title},
            "width": "fill",
            "vertical_align": "center",
            "icon": dict(PANEL_ICON),
            "icon_position": "right",
            "icon_expanded_angle": -180,
        },
        "vertical_spacing": "8px",
        "elements": elements,
    }


def build_overview_card(view: Overview, redact=None, expand: str = "",
                        seen_at: Any = _AUTO, viewer: str = OWNER_VIEWER, settled: Any = _AUTO) -> str:
    """总览：按工具分组，一行一个会话（点一行进详情），最后是读失败的说明 + 刷新。

    用户原话「文字太多 手机上显示不全」⇒ 一组里**一样的那几样**（工具名、项目）在
    分组标题上说一次，行里只留状态点 + 会话名 + 多久前（`row_label` / `group_heading`）。

    第 28 轮：每组是一个**折叠面板**。有在跑 / 等你的 ⇒ 默认展开；全闲着 ⇒ 收起，标题上写清
    「（5 个）· 都闲着」。每组最多列 `MAX_ROWS_PER_TOOL` 行，多出来的是一个「点开看全部」按钮
    （op=more）⇒ 回调原地换成 `expand=<那个工具>` 的这张卡：那一组展开、全列出来，别的组照旧。
    全列出来超 20KB / 200 个组件时少放几行，最后一句写清「还有 N 个放不下，在电脑上看」。

    第 32 轮：状态按 `display_status` 分得更细（等你批准 / 等你回答 / 出错了 / 跑完没看），
    每组按 `DISPLAY_RANK` 重排。`seen_at` = 上一次给这个人发总览卡的时间（`OVERVIEW_SEEN.before`）；
    不传 ⇒ 自己查 `OVERVIEW_SEEN`（`viewer` 名下、早于这次扫描的那一次），造完普通卡就把这次记上；
    「看全部」（`expand`）用的是同一次扫描，只查不记。显式传 None ⇒ 不判「跑完没看」，也不记。

    🔴 记的是「造好了这张卡」不是「飞书说发到了」：卡片发不出去时 app.py 会退成文字，
    那条文字里同样是这些会话，他照样看到了。

    第 33 轮：主人点过「✓ 结束」的会话不列（`settled`，默认 `fleet.settled.active()`；显式 None ⇒ 不藏）。
    有新动静的自己回来（`SettledStore.split` 顺手删掉它的记录）。底部写一句「已结束 N 个」。
    """
    record = seen_at is _AUTO and not expand
    if seen_at is _AUTO:
        seen_at = OVERVIEW_SEEN.before(viewer, getattr(view, "at", 0) or None)
    view, gone = _drop_settled(view, settled)
    try:
        return _build_overview_card(view, redact, expand, seen_at, gone)
    finally:
        if record:
            OVERVIEW_SEEN.mark(viewer, getattr(view, "at", 0))


SETTLED_NOTE = "✓ 已结束 {n} 个（有新动静会自己回来）"


def _drop_settled(view: Overview, settled: Any) -> tuple:
    """(去掉已结束的那份 Overview, 藏了几个)。记录读不出 / 出任何错 ⇒ 原样、0 —— 总览绝不能因为它出不来。"""
    import dataclasses

    if settled is None:
        return view, 0
    try:
        if settled is _AUTO:
            from .settled import active

            settled = active()
        shown, gone = settled.split(list(view.sessions or ()))
        if not gone:
            return view, 0
        return dataclasses.replace(view, sessions=shown), gone
    except Exception:  # noqa: BLE001
        import logging

        logging.getLogger("feishu-bridge.fleet").exception("读「已结束」记录失败，这次全列出来")
        return view, 0


def _build_overview_card(view: Overview, redact, expand: str, seen_at: Optional[float],
                         gone: int = 0) -> str:
    clean = redact or (lambda s: s)
    groups = {tool: sort_for_overview(items, seen_at) for tool, items in view.by_tool().items()}
    expand = expand if expand in TOOLS and groups.get(expand) else ""

    def build(rows: int, wide: int) -> str:
        """`rows`：普通组列几行；`wide`：被展开的那一组列几行。"""
        elements: list = []
        elements.append(_md(overview_headline(view.sessions, seen_at) + "点一行看最近几条、接着聊或停下。"))
        if not view.sessions and not gone:
            elements.append(_md("一个会话都没读到。", small=True))
        for tool in TOOLS:
            items = groups.get(tool) or []
            if not items:
                continue
            opened = tool == expand
            cap = wide if opened else rows
            shown = [_cleaned(s, clean) for s in items[:cap]]
            main = main_project(shown)
            tags = dup_tags(shown, row_names(shown, main, seen_at))
            inner: list = []
            for sess, tag in zip(shown, tags):
                label = row_label(sess, shared_project=main, with_tool=False, dup_tag=tag, seen_at=seen_at)
                # 🔴 只有「等你」的那几行用醒目的主按钮。原来是「有进程或在跑」就主按钮
                # ⇒ 终端里闲着的会话也是蓝的，一屏全蓝，等于没有重点（2026-11-06 UX 侦察）。
                inner.append(_button(label, fleet_value("open", tool, sess.id),
                                     primary=display_status(sess, seen_at) in _URGENT))
                # 「等你」⇒ 紧跟一句它在问什么，省掉「点进详情才看得见」那一下（第 17 轮）。
                # 🔴 必须紧跟在**它自己**那个按钮后面：上下两行都在等你时才分得清谁问的。
                asked = overview_pending_line(sess, clean)
                if asked:
                    inner.append(_md(asked, small=True))
            hidden = items[cap:]
            if hidden and opened:
                # 已经是「看全部」了还放不下 ⇒ 再给一个按钮也只是同一张卡，照实叫他回电脑上看
                inner.append(_md(overflow_note(hidden, seen_at), small=True))
            elif hidden:
                inner.append(_button(more_button_label(hidden, seen_at), fleet_value("more", tool)))
            # 🔴 展开与否看**整组**（不只是列出来的那几行）：藏着的那几个要他管，也得展开让他看见那个按钮
            expanded = opened or any(_busy(s, seen_at) for s in items)
            elements.append(_panel(panel_title(tool, items, shown, clean, seen_at), expanded, inner))
        legend = status_legend(view.sessions, seen_at)
        if legend:
            elements.append(_md(legend, small=True))
        if gone:
            elements.append(_md(SETTLED_NOTE.format(n=gone), small=True))
        if view.notes:
            elements.append({"tag": "hr"})
            elements.append(_md("\n".join(
                "⚠️ " + escape_card(short_title(_safe_clean(clean, n), NOTE_CHARS), keep_format=True)
                for n in view.notes[:6]), small=True))
        elements.append(_button("🔄 刷新", fleet_value("refresh")))
        return _card("🖥 电脑上的会话", "blue", elements)

    if not expand:
        return _fit(lambda rows: build(rows, rows), MAX_ROWS_PER_TOOL)
    # 展开的那一组：别的组照普通卡的样子放（普通卡放得下几行就几行），剩下的地方全给这一组。
    base = MAX_ROWS_PER_TOOL
    while base > 1 and not _fits(build(base, base)):
        base -= 1
    if not _fits(build(base, base)):
        return build(base, base)  # 一行都放不下（只有极端的超长说明才会）⇒ 和普通卡同样的结局
    total = len(groups.get(expand) or [])
    # 二分：这一组最多能放几行（行数越多越大，单调）
    lo, hi = min(base, total), total
    while lo < hi:
        mid = (lo + hi + 1) // 2
        if _fits(build(base, mid)):
            lo = mid
        else:
            hi = mid - 1
    return build(base, lo)


# ---------- 「等你」时它在问什么（第 8 轮）----------

# 每样最多显示多少字。整段的上限是为了不跟最近消息抢 20KB：最坏（全是要转义的字符）也就几 KB。
PENDING_QUESTIONS = 3
PENDING_OPTIONS = 6
PENDING_QUESTION_CHARS = 120
PENDING_HEADER_CHARS = 20
PENDING_LABEL_CHARS = 30
PENDING_DESC_CHARS = 40
PENDING_SUMMARY_CHARS = 160
_CIRCLED = "①②③④⑤⑥⑦⑧⑨⑩"
# 🔴 第 2 步（手机上点选项回答）**不做**：relay 发的是会话间消息，能不能当 AskUserQuestion 的答案
# 没验过、很可能不能。所以这里不挂按钮，明说要回电脑上点 —— 别给一个点了没用的按钮。
PENDING_FOOT = "要在电脑上点：手机上还答不了这一步。"

# 总览里「它在问什么」那一句的预算。比详情卡**窄得多**：总览一屏要放 8 行 × 3 家，
# 这一句只是让他在列表上就看出「是不是我现在就得管」，看全文点进去就是（详情卡那段不变）。
OVERVIEW_PENDING_CHARS = 48
OVERVIEW_PENDING_OPTIONS = 4
OVERVIEW_OPTION_CHARS = 10


def _pending_tool_label(name: str) -> str:
    """工具的人话名（照 `status._TOOL_LABEL`）；不认识的原样放进行内代码。"""
    from ..status import _TOOL_LABEL

    return _TOOL_LABEL.get(name) or inline_code(str(name or "")[:60])


def _clip(clean, text: str, limit: int) -> str:
    """🔴 **先脱敏整段、再截断、最后转义**（顺序同 `build_detail_card` 的红字）。"""
    return _escape(short_title(clean(text or ""), limit))


def pending_elements(sess: Session, clean) -> list:
    """「等你」的会话卡在哪一步 → 详情卡上最近消息之前的那一段；没有 / 读不出来 ⇒ []。

    - AskUserQuestion ⇒「❓ 它在问你：〈题目〉」+ ①A ②B …（label 全给，description 截短）
    - 别的工具 ⇒「⏸ 它在等你确认：〈人话工具名〉〈一行摘要〉」
    - 末尾小字「要在电脑上点」

    🔴 这一段出任何错（脱敏函数炸了、字段形状不对）都只是**这一段不显示**，详情卡照常出。
    """
    pending = getattr(sess, "pending", None)
    if sess.status != "waiting" or pending is None:
        return []
    try:
        lines: list = []
        questions = tuple(pending.questions or ())[:PENDING_QUESTIONS]
        if questions:
            for q in questions:
                head = f"**{_clip(clean, q.header, PENDING_HEADER_CHARS)}** · " if q.header else ""
                multi = "（可多选）" if q.multi else ""
                lines.append(f"❓ 它在问你：{head}{_clip(clean, q.question, PENDING_QUESTION_CHARS)}{multi}")
                opts = tuple(q.options or ())
                for i, (label, desc) in enumerate(opts[:PENDING_OPTIONS]):
                    mark = _CIRCLED[i] if i < len(_CIRCLED) else f"({i + 1})"
                    row = f"{mark} {_clip(clean, label, PENDING_LABEL_CHARS)}"
                    if desc:
                        row += f"：{_clip(clean, desc, PENDING_DESC_CHARS)}"
                    lines.append(row)
                if len(opts) > PENDING_OPTIONS:
                    lines.append(f"…还有 {len(opts) - PENDING_OPTIONS} 个选项")
            if len(pending.questions) > PENDING_QUESTIONS:
                lines.append(f"…还有 {len(pending.questions) - PENDING_QUESTIONS} 道题")
        else:
            what = _pending_tool_label(pending.tool)
            summary = short_title(clean(pending.summary or ""), PENDING_SUMMARY_CHARS)
            if summary:
                # 行内代码里原样不转（`escape_card(keep_format=True)` 只拆 @）
                what += " " + escape_card(inline_code(summary), keep_format=True)
            lines.append(f"⏸ 它在等你确认：{what}")
        return [_md("\n".join(lines)), _md(PENDING_FOOT, small=True)]
    except Exception:  # noqa: BLE001
        return []


def overview_pending_line(sess: Session, clean) -> str:
    """总览里紧跟在那一行底下的一句「它在问你…」；没有 / 读不出来 ⇒ 空串。

    第 17 轮（`docs/iteration/r14-redundant-taps.md` 第 5 条）：原来「等你」在列表上只有一个
    🟡 点，**它在问什么要点进详情才看得到**（看一眼要 1 下）。同一段话点一下就出现在同一张
    卡的下一层 ⇒ 隐私上没有差别（第 7 轮「卡上不放内容」的理由是隐私 + 卡片大小），
    而大小这边自己有上限（上面那三个常量 + `_fit` 的收缩循环照旧兜底）。

    🔴 顺序和详情卡一样：**先整段脱敏、再截断、最后转义**（`_clip`）。
    🔴 出任何错都只是**这一句不显示**（同 `pending_elements`）—— 总览绝不能因为它发不出去。
    """
    pending = getattr(sess, "pending", None)
    if sess.status != "waiting" or pending is None:
        return ""
    try:
        questions = tuple(pending.questions or ())
        if questions:
            first = questions[0]
            text = _clip(clean, first.question, OVERVIEW_PENDING_CHARS)
            if not text:
                return ""
            opts = [_clip(clean, label, OVERVIEW_OPTION_CHARS)
                    for label, _desc in tuple(first.options or ())[:OVERVIEW_PENDING_OPTIONS]]
            line = f"❓ 它在问你：{text}"
            if opts:
                line += "　" + " ".join(f"{_CIRCLED[i]} {o}" for i, o in enumerate(opts) if o)
            more = len(questions) - 1
            return line + (f"（还有 {more} 道题）" if more > 0 else "")
        what = _pending_tool_label(pending.tool)
        summary = short_title(clean(pending.summary or ""), OVERVIEW_PENDING_CHARS)
        if summary:
            what += " " + escape_card(inline_code(summary), keep_format=True)
        return f"⏸ 它在等你确认：{what}"
    except Exception:  # noqa: BLE001
        return ""


def build_detail_card(sess: Session, messages: list, redact=None, note: str = "",
                      talking: bool = False, group_link: str = "") -> str:
    """详情：最近 4 条 + [接着聊]（`can_send` 或 `can_relay`）[停下]（can_stop）[刷新]。

    `can_send` 和 `can_relay` 是两条不同的路（见 `model.Session` 的红字），但在手机上
    **是同一个按钮** —— 用户要的只是「跟它接着说」，哪条路进去是我们的事。选路在
    `control.send()`。

    `talking=True`：这个聊天现在正和这个会话说话（对话模式）⇒ 卡片上要**一直显示**
    「正在和 X 说话，退出发 /cancel」。spec 要求这条指示器在对话模式里不能消失：
    不然用户看完回复随口接一句，那句会悄悄落到别的地方去。

    `group_link`：这个会话**已经有群**时那个群的直开链接（app 那边只在单聊、能接着聊、
    绑定表里有群时才给，不调接口）。有它 ⇒「接着聊」同一个按钮**跳进群 + 回调 op=go**，
    一下进群（第 14 轮）。链接不过白名单 ⇒ 退回只回调的老按钮。
    """
    clean = redact or (lambda s: s)
    can_talk = bool(sess.can_send or sess.can_relay)
    # 「等你」时它在问什么 / 等你确认哪一步。只算一次（下面收缩循环每轮都 build，脱敏别跑好几遍）
    pending = pending_elements(sess, clean)

    def build(chars: int) -> str:
        where = f"{TOOL_LABELS.get(sess.tool, sess.tool)} · {SURFACE_LABELS.get(sess.surface, sess.surface)}"
        # 第 32 轮：详情卡也用细分后的说法（等你批准 / 等你回答 / 出错了）；不判「跑完没看」——点进来就是在看了
        where += f" · {inline_code(project_of(sess.cwd))} · {display_label(sess)}"
        if sess.age_text:
            where += f" · {sess.age_text}"
        if sess.id:
            where += f" · {inline_code(str(sess.id)[:8])}"
        elements: list = [_md(where, small=True)]
        if sess.title:
            elements.append(_md("**" + _escape(short_title(clean(sess.title), 60)) + "**"))
        if talking:
            elements.append(_md(talking_banner(sess, clean)))
        if note:
            # 🔴 `note` / `why` 是**外来的长文本**（adapter 把整段 stderr 塞进 last_error、
            # control.detail 把异常原文拼进 note），而下面那个收缩循环只缩消息正文 `chars` ⇒
            # 一条 4 万字的报错能让整张卡永远超 20KB、消息缩到 40 字也下不来。
            # 飞书对超大卡片是**静默丢弃** ⇒ 用户点了 [看看它] 什么都收不到（2026-11-04 审查）。
            # note 本来就是一句说明，先剪到和总览一样的预算。
            elements.append(_md("⚠️ " + _escape(short_title(clean(note), NOTE_CHARS)), small=True))
        if pending:
            # 放在最近消息**之前**：主人点进「等你」的会话，第一眼要看到的是它在等什么
            elements.append({"tag": "hr"})
            elements.extend(pending)
        elements.append({"tag": "hr"})
        if messages:
            for msg in messages[-4:]:
                who = ROLE_LABELS.get(getattr(msg, "role", ""), getattr(msg, "role", ""))
                # 🔴 **先脱敏整段、再截断**。反过来的话：私钥块的 END 行被截掉 ⇒
                # 整块匹配不上 ⇒ 密钥正文原样发进飞书；JSON 值被截断丢了收尾引号同理
                # （2026-11-04 安全审查实测）。
                # 每条单独一个 markdown 元素：一条里没关上的 ``` 染不到下一条（双保险，
                # message_md 本身也不会留半个代码块）。
                elements.append(_md(message_md(who, clean(getattr(msg, "text", "") or ""), chars,
                                               max(4, MSG_PREVIEW_LINES * chars // MSG_PREVIEW_CHARS))))
        else:
            elements.append(_md("（没读到消息）", small=True))
        elements.append({"tag": "hr"})
        buttons = []
        if can_talk:
            label = "💬 继续说" if talking else "💬 接着聊"
            jump = jump_callback_button(label, group_link, fleet_value("go", sess.tool, sess.id)) \
                if group_link else None
            buttons.append(jump or _button(label, fleet_value("send", sess.tool, sess.id), primary=True))
        if sess.can_stop:
            buttons.append(_button("⏹ 停下", fleet_value("stop", sess.tool, sess.id)))
        buttons.append(_button("🔄 刷新", fleet_value("refresh", sess.tool, sess.id)))
        if _can_settle(sess):
            # 第 33 轮：「这个我不管了」⇒ 总览不再列它。在跑 / 等你的不给（`settled.can_settle`）
            buttons.append(_button(SETTLE_LABEL, fleet_value("settle", sess.tool, sess.id)))
        for i in range(0, len(buttons), 2):
            elements.append(_row(buttons[i:i + 2]))
        why = []
        if not can_talk:
            # 🔴 两条路都走不通才贴拒绝理由，而且**优先贴 relay 那句**：
            # 终端里开着的会话现在走 relay，`why_not_send` 那句「会分叉成两段对话」
            # 是另一条路的理由，贴出来会让用户以为「开着就没法从手机说话」—— 那已经不对了。
            why_talk = sess.why_not_relay if sess.owner == "terminal" else ""
            why_talk = why_talk or sess.why_not_send or sess.why_not_relay
            if why_talk:
                why.append("💬 " + why_talk)
        if not sess.can_stop and sess.why_not_stop and (sess.pids or sess.status == "running"):
            why.append("⏹ " + sess.why_not_stop)
        if why:
            # 同 note：拒绝理由也可能是拼出来的长串（见上面红字），一条一条剪
            elements.append(_md("\n".join(
                escape_card(short_title(w, NOTE_CHARS), keep_format=True) for w in why), small=True))
            # 第 17 轮：拒绝理由里**叫他去点哪个按钮**，就把那个按钮放在这张卡上。
            # 实测（`docs/iteration/r14-redundant-taps.md` 第 6 条 + 本轮 tests/test_r17_taps.py）：
            # 「这个项目不在手机能用的目录里…点「📂 换项目」」—— 而「换项目」不在常驻菜单里
            # （`botmenu.MENU_TREE` 把它挪进了「全部按钮」）⇒ 照着做要 ⚡常用 → 全部按钮 →
            # 换项目，**3 下**。放在这里就是 1 下。
            #
            # 🔴 只给这一个、只按**这张卡上真写了那句话**判，不按理由的来源判（三家 adapter
            # 各有一句同义的，字面都带「换项目」）。别的「叫你去点」一律不补：
            # - 「🔑 权限」本来就是常驻菜单一级节点（1 下），放了省不下
            # - 「全授权」要走它自己的二次确认（`menu.build_confirm_loosen_card`），不许抄近道
            # - 「回到那个对话点「⏹ 停下」」说的是**另一个聊天**里的停下，补了会停错东西
            if any("换项目" in w for w in why):
                elements.extend(button_rows([do_button("dirs")]))
        # 原来这里是一行「退出对话模式发 /cancel；发「会话」回到总览」⇒ 换成按钮（actions.py）
        elements.extend(detail_nav_rows(talking))
        return _card("🖥 " + short_title(f"{TOOL_LABELS.get(sess.tool, sess.tool)} 会话", 30), "indigo", elements)

    chars = MSG_PREVIEW_CHARS
    blob = build(chars)
    while len(blob.encode("utf-8")) > MAX_CARD_BYTES and chars > 40:
        chars //= 2
        blob = build(chars)
    return blob


# ---------- 结束（第 33 轮，`fleet/settled.py`）----------

SETTLE_LABEL = "✓ 结束"


def _can_settle(sess: Session) -> bool:
    from .settled import can_settle

    return can_settle(sess)[0]


def build_settled_card(sess_or_target: Any, redact=None) -> dict:
    """点完「✓ 结束」原地换成的卡（dict，直接放进回调响应）：「✓ 已结束 · 撤销」。

    🔴 写清「只记在手机这边」：电脑上那个会话一点没动，别让他以为删掉了。
    """
    clean = redact or (lambda s: s)
    label = _escape(session_label(sess_or_target, clean))
    tool = getattr(sess_or_target, "tool", "")
    sid = str(getattr(sess_or_target, "id", "") or "")
    elements = [
        _md(f"{label} 不再出现在总览里。它有新动静会自己回来。"),
        _md("只记在手机这边，电脑上那个会话没动。", small=True),
        _row([
            _button("↩︎ 撤销", fleet_value("unsettle", tool, sid)),
            do_button("sessions", "🖥 回到总览"),
        ]),
    ]
    return json.loads(_card("✓ 已结束", "grey", elements))


def build_unsettled_card(sess_or_target: Any, redact=None) -> dict:
    """点了「撤销」之后原地换成的卡（dict）。"""
    clean = redact or (lambda s: s)
    label = _escape(session_label(sess_or_target, clean))
    tool = getattr(sess_or_target, "tool", "")
    sid = str(getattr(sess_or_target, "id", "") or "")
    elements = [
        _md(f"好，{label} 回到总览里了。"),
        _row([
            _button("👀 看看它", fleet_value("open", tool, sid), primary=True),
            do_button("sessions", "🖥 回到总览"),
        ]),
    ]
    return json.loads(_card("↩︎ 已撤销", "indigo", elements))
CARHER_PY_EOF

write_file "$APP_HOME/bridge/fleet/control.py" <<'CARHER_PY_EOF'
"""会话总控的状态：最近一次扫描、每个聊天的「待发目标」、把发 / 停分给对应那家。

飞书那一层（`bridge/app.py`）只管收发；这里不碰飞书、只用标准库，方便单测。

- **已知 id**：只有最近一次扫描（总览或详情刷新）里出现过的 (tool, id) 才能被按钮点到。
- **待发目标**：点 [接着聊] 之后，这个聊天的下一条普通消息发到那个会话。一个聊天只记一个，
  5 分钟过期；`/cancel` 或「取消」清掉。真正发之前 adapter 会**在锁里再查一次**能不能发
  （五分钟里终端可能打开了它）。
- **对话模式**：点 [接着聊] 进去之后**一直**发给那个会话，直到 `/cancel`。
  进去之前要过一次权限确认（`consent.RelayConsent`，24 小时记忆）。

## 两条路的分工（别混）

| | 走哪个方法 | 什么时候能用 |
|---|---|---|
| 普通「接着聊」 | `adapter.send()` | **没人占着**那个会话（Claude 一定要没人占，不然分叉） |
| 对话模式 | `adapter.relay()` / `Relay.send()` | 目标**正开着**也行（会话间消息 / codex queue） |
"""

from __future__ import annotations

import logging
import threading
import time
from dataclasses import dataclass
from typing import Any, Callable, Optional

from .model import ActionResult, Session, friendly_error
from .scan import TOOL_LABELS, Fleet, Overview

logger = logging.getLogger("feishu-bridge.fleet")

PENDING_TTL_SEC = 5 * 60
DETAIL_MESSAGES = 4

WHY_NO_ADAPTER = "这类会话这台电脑上读不了。"
# 工作目录白名单之外。手机用户改不了 config.toml —— 告诉他在哪看、找谁改，不甩术语。
# 🔴 app._maybe_send_to_fleet 靠**开头那半句**认出它、给它配「换项目」按钮 —— 开头别改。
WHY_OUTSIDE_WORKSPACE = (
    "这个项目不在手机能用的目录里，先不发。点「换项目」看现在能用哪些；"
    "要放开得在电脑上改这个助手的设置。"
)
WHY_UNKNOWN_TARGET = "这个会话不在刚才的列表里了，点「回到总览」重新看一眼。"


@dataclass(frozen=True)
class Target:
    tool: str
    id: str
    title: str
    expires_at: float

    @property
    def label(self) -> str:
        name = self.title or self.id[:8]
        return f"{TOOL_LABELS.get(self.tool, self.tool)}「{name}」"


class FleetControl:
    def __init__(self, fleet: Fleet, *, ttl: float = PENDING_TTL_SEC,
                 now: Callable[[], float] = time.time) -> None:
        self.fleet = fleet
        self.ttl = float(ttl)
        self._now = now
        self._lock = threading.Lock()
        self._known: dict = {}  # (tool, id) → Session（最近一次扫描）
        self._pending: dict = {}  # scope → Target
        self.last: Optional[Overview] = None

    # ---------- 扫描 ----------

    def overview(self) -> Overview:
        view = self.fleet.overview()
        with self._lock:
            # 🔴 **按家合并**，不整体替换。某一家这次读超时 / 被跳过时它不在结果里 ——
            # 整体替换会把它的编号全清掉，用户点之前那张卡上的按钮就报「过期了」
            # （2026-11-04 稳定性审查）。只替换这次真读到的那几家。
            fresh_tools = {sess.tool for sess in view.sessions}
            fresh_tools |= set(getattr(view, "ok_tools", ()) or ())
            kept = {k: v for k, v in self._known.items() if k[0] not in fresh_tools}
            kept.update({sess.key: sess for sess in view.sessions})
            self._known = kept
            self.last = view
        return view

    def known_keys(self) -> set:
        with self._lock:
            return set(self._known)

    def cached(self, tool: str, sid: str) -> Optional[Session]:
        with self._lock:
            return self._known.get((tool, sid))

    def _remember(self, sess: Session) -> None:
        with self._lock:
            self._known[sess.key] = sess

    def refresh(self, tool: str, sid: str) -> tuple:
        """现查一个会话还在不在 → (Session 或 None, 读失败时的一句话)。

        给「一个群 = 一个会话」用（bridge/fleet/chatbind.py）：群绑定是长期的，
        重启之后 `_known` 是空的，群里来一条消息时要靠这里把那个会话重新认回来。
        - 查到了 ⇒ 记进 `_known`（之后确认卡、停下这些按钮才点得动）
        - `(None, "")` ⇒ **确实没了**（电脑上关掉了 / 删了）
        - `(None, "原因")` ⇒ **没读出来**，不知道在不在 —— 调用方别当成「没了」
        """
        adapter = self.fleet.adapter(tool)
        if adapter is None:
            return None, WHY_NO_ADAPTER
        try:
            sess = adapter.find(sid)
        except Exception as exc:  # adapter 约定不抛；保险
            return None, friendly_error(exc, "现在读不出它的状态", log_as=f"现查会话失败 tool={tool}")
        if sess is None:
            # 🔴 **「找不到」和「读不出来」要分开**。2026-11-05 体验审查：Codex 的 state db
            # 被 App 锁住、Cursor 的库读不到时 find() 也返回 None ⇒ 群里报「会话已经关掉或删了」，
            # 而它其实还在电脑上好好跑着。读失败时把 adapter 的 last_error 带出去，
            # 调用方走「读不出来」那条分支（app.py 的「现在读不出它的状态」）。
            err = str(getattr(adapter, "last_error", "") or "")
            if err:
                return None, f"现在读不出它的状态：{err}"
            return None, ""
        self._remember(sess)
        return sess, ""

    def detail(self, tool: str, sid: str, n: int = DETAIL_MESSAGES) -> tuple:
        """(Session 或 None, 最近 n 条, 一句说明)。状态现查；查不到用上次扫描的并说明。"""
        adapter = self.fleet.adapter(tool)
        if adapter is None:
            return None, [], WHY_NO_ADAPTER
        note = ""
        fresh = None
        try:
            fresh = adapter.find(sid)
        except Exception as exc:  # adapter 约定不抛；保险
            note = friendly_error(exc, "现在的状态没读出来", log_as=f"刷新会话状态失败 tool={tool}")
        sess = fresh or self.cached(tool, sid)
        if fresh is None and sess is not None and not note:
            note = "现在的状态没读出来，下面是刚才列表里的样子。"
        if sess is not None:
            self._remember(sess)
        try:
            messages = list(adapter.read(sid, n) or [])
        except Exception as exc:
            messages = []
            note = note or friendly_error(exc, "最近的消息没读出来")
        if not messages and getattr(adapter, "last_error", ""):
            note = note or str(adapter.last_error)
        return sess, messages, note

    # ---------- 待发目标 ----------

    def set_pending(self, scope: str, tool: str, sid: str) -> Target:
        sess = self.cached(tool, sid)
        title = (sess.title if sess is not None else "") or ""
        target = Target(tool, sid, title, self._now() + self.ttl)
        with self._lock:
            self._pending[scope] = target
        return target

    def peek_pending_fresh(self, scope: str) -> tuple:
        """(没过期的 Target 或 None, 是否过期)。**只看不取** —— 取走是 /cancel / 过期的事。

        🔴 原来发消息走 `take_pending`（看一眼就清掉），导致消息在飞的那段时间里
        「在不在对话模式」这个状态凭空消失：补一句会落进桥自己的 claude、/cancel 说
        没东西可取消、刷新卡片看不出在跟谁说话（2026-11-04 三个审查角色各自撞到）。
        """
        target = self.peek_pending(scope)
        if target is None:
            return None, False
        if self._now() > target.expires_at:
            return None, True
        return target, False

    def peek_pending(self, scope: str) -> Optional[Target]:
        with self._lock:
            return self._pending.get(scope)

    def take_pending(self, scope: str) -> tuple:
        """(Target 或 None, 是否已过期)。取出即清掉。"""
        with self._lock:
            target = self._pending.pop(scope, None)
        if target is None:
            return None, False
        if self._now() > target.expires_at:
            return None, True
        return target, False

    def clear_pending(self, scope: str) -> Optional[Target]:
        with self._lock:
            return self._pending.pop(scope, None)

    # ---------- 发 / 停 ----------

    def send(self, tool: str, sid: str, text: str, *, policy: Any = None, approval_dir: str = "",
             timeout: float = 600, relay: bool = False) -> ActionResult:
        """按家分派。三家的 send 都在锁里**再查一次**有没有人占着，这里不重复查。

        `relay=True`：走「进会话聊天」那条路（adapter 的 `relay()`）。Codex / Cursor 的
        relay 和 send 的区别在**能不能发给一个别人正开着的会话**、以及怎么取回复；
        没实现 relay 的那家自动退回 `send()`，调用方不用分情况。
        """
        adapter = self.fleet.adapter(tool)
        if adapter is None:
            return ActionResult(False, WHY_NO_ADAPTER, sid)
        try:
            if tool == "claude":
                # 🔴 **终端里开着的会话只能走 relay**。`send()` 那条路是 `claude -p --resume`，
                # 对一个有进程占着的会话会在同一个 jsonl 里**静默分叉**，终端那边永远看不到
                # （claude.py 模块头的实测）。所以这里按「有没有人占着」选路，不按调用方的心愿：
                # relay=True 但其实没人占着 ⇒ 还是走 send（同步拿回复，不用等信使）；
                # relay=False 但终端占着 ⇒ send 自己会拒（它在锁里复查），不会分叉。
                if relay and hasattr(adapter, "relay"):
                    can, why = self._claude_relay_ready(adapter, sid)
                    if can:
                        # relay 不起目标进程、不传档位：目标用的是它在电脑上那套权限
                        return adapter.relay(sid, text, timeout=timeout)
                    if why:
                        return ActionResult(False, why, sid)
                return adapter.send(sid, text, timeout=timeout, policy=policy, approval_dir=approval_dir)
            # 🔴 Codex / Cursor **一律按只读发**，不跟随手机上的档位。
            # 2026-11-04 安全审查：它们没有审批钩子，红线（删家目录、改桥的配置、写 App 数据库）
            # 和写边界都只在 Claude 那条路上生效。本机 ~/.codex/config.toml 是
            # danger-full-access，全授权档原来**不压 sandbox** ⇒ 从手机发进 Codex 等于整机全开；
            # Cursor 全授权会带 `--force`。在有等价的护栏之前，手机只能让它们看和回答。
            # 工作目录也要和 Claude 一样过一遍白名单。
            cwd = self._cwd_of(tool, sid)
            if cwd and policy is not None and hasattr(policy, "resolve_workspace"):
                if policy.resolve_workspace(cwd) is None:
                    return ActionResult(False, WHY_OUTSIDE_WORKSPACE, sid)
            method = getattr(adapter, "relay", None) if relay else None
            if method is None:
                method = adapter.send
            return method(sid, text, timeout=timeout, mode="readonly")
        except Exception as exc:
            # 不带前缀：app.py 那边已经套了「❌ 没发进去：」，再加一层就是「没发进去：没发出去：」
            return ActionResult(False, friendly_error(exc, log_as=f"会话总控发送失败 tool={tool}"), sid)

    def _claude_relay_ready(self, adapter: Any, sid: str) -> tuple:
        """这条 Claude 会话该不该走 relay → (走不走, 不走时要不要告诉用户为什么)。

        `why` 为空串的意思是「**退回 `send()`**」，不是「拒绝」：没人占着的会话走 resume
        那条路更好（同步拿回复，不用起信使），而 `send()` 自己会在锁里复查一次。
        `why` 有内容才是真的做不到，照实说。
        """
        checker = getattr(adapter, "can_relay", None)
        if checker is None:
            return False, ""
        try:
            can, why = checker(sid)
        except Exception as exc:  # adapter 约定不抛；防它自己炸
            return False, friendly_error(exc, "看不出能不能送进去", log_as=f"查能不能接着聊失败 sid={sid}")
        if can:
            return True, ""
        # 不能 relay。终端正占着它 ⇒ 只有 relay 这条路，没成就得说清为什么
        # （退回 send() 的话会被「会分叉」拒绝，那句话在 relay 存在之后是误导）。
        sess = self.cached("claude", sid)
        if sess is not None and sess.owner == "terminal":
            return False, why or "现在送不进去。到电脑上和它说吧。"
        return False, ""

    def _cwd_of(self, tool: str, sid: str) -> str:
        sess = self.cached(tool, sid)
        return str(getattr(sess, "cwd", "") or "") if sess else ""

    def stop(self, tool: str, sid: str, *, relay: bool = False) -> ActionResult:
        """`relay=True`：对话模式里的 `/stop`。

        停不了的一律照实说在哪停（Claude 终端会话、Codex App / 终端那一轮都停不了），
        **不假装能停** —— 从外面发信号会直接关掉用户整个会话。
        """
        adapter = self.fleet.adapter(tool)
        if adapter is None:
            return ActionResult(False, WHY_NO_ADAPTER, sid)
        try:
            method = (getattr(adapter, "relay_stop", None) if relay else None) or adapter.stop
            return method(sid)
        except Exception as exc:
            return ActionResult(False, friendly_error(exc, "没停成", log_as=f"会话总控停止失败 tool={tool}"), sid)


def build_default(*, policy: Callable[[], Any], bridge_home: str, hook_settings: Any = None,
                  jobs: Any = None) -> FleetControl:
    """真实家目录下的三家 + 一份共用的 FleetJobs。"""
    from .claude import ClaudeAdapter
    from .codex import CodexAdapter
    from .cursor import CursorAdapter
    from .model import FleetJobs

    jobs = jobs if jobs is not None else FleetJobs()
    adapters = {
        "claude": ClaudeAdapter(bridge_home=bridge_home, jobs=jobs, policy=policy,
                                hook_settings=hook_settings),
        "codex": CodexAdapter(jobs=jobs),
        "cursor": CursorAdapter(jobs=jobs, mode=lambda: getattr(policy(), "mode", "readonly")),
    }
    return FleetControl(Fleet(adapters))
CARHER_PY_EOF

write_file "$APP_HOME/bridge/fleet/relay.py" <<'CARHER_PY_EOF'
"""进会话聊天（Claude 终端会话）：把一句话送进电脑上**正开着**的那个会话，再把回复取回来。

和 `claude.py` 的 `send()` 是两条完全不同的路，别混：

- `claude.py` 的 send = `claude -p --resume <id>`，**只在没人占着**的会话上能用。
  有终端占着时它会在同一个 jsonl 里静默分叉，终端那边永远看不到。
- 这里的 relay = **会话间消息**（peer messaging）。目标正开着、正忙都行，消息进它的输入队列，
  它干完当前这一轮再处理，**不分叉**、不打断、不丢。

## 怎么送

起一个 `claude -p --input-format stream-json` 当**常驻信使**，让它调 `SendMessage` 发给目标的 `name`。
信使是我们自己起的子进程（登记进 `FleetJobs`），目标是用户的会话 —— **我们从不给目标发任何信号**。

### 为什么是常驻信使（2026-11-04 实测，北京时间 22:0x~22:5x）

「发出 → 目标 jsonl 里 enqueue 落地」的延迟：

| 路 | 中位 | 最差 | 备注 |
|----|------|------|------|
| 一次性 `claude -p`（默认模型/默认工具） | 10.6s | 41.5s | 抖动 7~41s，不可接受 |
| 一次性 + haiku + 压提示词 + 最小工具集 | 7.5s | 11.5s | 省不动：大头是冷启动 + 一整轮模型 |
| **常驻 `claude -p --input-format stream-json`（haiku）** | **4.8s** | **5.9s** | 7 次全中，就用这条 |
| `claude mcp serve` → `tools/call SendMessage`（不经模型） | 0.17s | — | 见下面「快车道」 |

这个模块本身的端到端（「调 send → 拿到目标的文字回复」，2026-11-04 23:24 实测，
一次性 TUI `relay-probe-target`）：**第一句 10.5s（含起信使），第二句 7.0s**。
拆开看：信使冷启动约 4s（第一句独有），`SendMessage` 落地 ~1.7s，目标自己答一句 ~2s，
回复收口再等 `REPLY_SETTLE_SEC`=3s。**把 settle 调小就能直接少 3 秒**，但多段回复会被切断，
所以留 3 秒；真要更快就得走下面那条快车道。

**快车道（默认不开，这里没实现）**：`claude mcp serve` 是官方 stdio MCP 子命令，暴露的 24 个工具里
就有 `SendMessage`，调它**全程没有模型 turn**，0.17s 到位（量了 13 次，抖动 ±0.01s）。
但它在 `~/.claude/sessions/` 只写 `.key`、不写 `<pid>.json`，attest 出的 `from-mode` 恒为 `"prompting"`，
给 `bypassPermissions` 的会话发就被**扣住等人点**（实测全部 held；`--permission-mode bypassPermissions` /
`--dangerously-skip-permissions` / `--settings '{"permissions":{"defaultMode":...}}'` 以及
`CLAUDE_CODE_EVEN_MORE_DANGEROUSLY_SKIP_PERMISSIONS=1` 都改不动这个值，每种试了 2~3 次）。
唯一放行的写法是**接收端启动时**带 `--settings '{"crossSessionInbound":"accept"}'` —— 那是用户自己的
权限决定，桥**不去改用户的 `~/.claude/settings.json`**，也不替他做。用户现有会话都没带，所以这条路
现在对他们用不上，留着当以后的开关。

## 怎么确认「真送达」

**不能只认 `type=user, isMeta=true` 那一行** —— 那是目标 idle 时的形状；目标正忙时只会先写

    {"type":"queue-operation","operation":"enqueue",
     "content":"<cross-session-message from=\"uds:/tmp/cc-socks/<pid>.sock\" from-name=\"…\"
                 from-mode=\"bypass\">正文</cross-session-message>"}

之后走 `attachment` / `api-request-blob`，那条 `user/isMeta` 要等它这一轮腾出手才出现。
只认旧形状 ⇒ 目标一忙就**假超时**（实测量出 4 个 null，复核全部已送达）。
所以两种行都认，哪条先到算哪条。

`from-mode` 是 `"bypass"` / `"prompting"` 二值，就是「权限模式同类」的实际载体：
发送方和接收方不同类 ⇒ 消息被扣住，目标终端里弹「Held message from another session」等人点。
所以发之前要比一次，送达后再从 enqueue 行里把 `from-mode` 读回来复核一次。

## 接收端自己也会去重（2026-11-04 端到端实测拿到的）

一字不差的同一句话紧跟着再发一遍：`SendMessage` 仍然返回 success，但**接收端的 inbox 把重复的丢了**，
目标 jsonl 里不再出现第二条 enqueue，而发送方会收到一条

    [Cross-session delivery notice] Do not resend now: one of your messages to another session
    was dropped at that session's inbox (recipient: uds:…; msg_id: …)

所以「等不到落地」有两种完全不同的原因，文案不能混：真没送到（`TEXT_NO_CONFIRM`，劝他去电脑上看）
vs 被当重复丢了（`TEXT_DEDUPED`，上一条其实送到了，劝他换个说法）。
去重窗口多长**没量过**，所以判据只用「这句话在保护窗口内送达过一次」，不号称精确。

## 停不了

目标那一轮**只能在电脑上按 Esc 停**。SIGINT 会杀掉整个会话（实测），所以 relay 一个信号都不发给目标，
`/stop` 在对话模式里只能照实说。见 `WHY_STOP_TARGET`。
"""

from __future__ import annotations

import json
import logging
import os
import re
import subprocess
import threading
import time
from dataclasses import dataclass
from typing import Any, Callable, Optional

from .claude import (
    WHY_SEND_APP,
    _CROSS_SESSION_RE,
    _FROM_NAME_RE,
    _content_text,
    _is_session_id,
    _read_tail,
    _parse_lines,
)
from .model import ActionResult, FleetJobs, friendly_error

logger = logging.getLogger("feishu-bridge.fleet")

TOOL = "claude"

# ---------- 参数（都量过，改之前先看上面的表） ----------

DEFAULT_TIMEOUT = 120.0        # 等回复的总时长，spec 默认 120 秒
DEFAULT_DELIVERY_TIMEOUT = 30.0  # 等「送达」那一行；常驻信使实测中位 4.8s、最差 5.9s
POLL_SEC = 0.1
REPLY_SETTLE_SEC = 3.0         # 第一段回复到了之后，再收 3 秒的后续段落
COURIER_IDLE_TTL = 15 * 60     # 这么久没发过就把信使收掉，不留常驻进程
COURIER_START_GRACE = 8.0      # 起信使之后等它写注册表（实测 0.2~1.7s，留足余量）
READ_CHUNK = 8 * 1024 * 1024   # 每次轮询最多读这么多新字节（目标可能一下写进一个大 blob）
MODE_TAIL_BYTES = 1024 * 1024  # 读目标当前权限模式用的尾部大小
MODE_TAIL_BYTES_WIDE = 8 * 1024 * 1024
RESEND_GUARD_SEC = 10 * 60     # 同一句话「送进去了但还没等到回复」时，这么久内不再发第二遍

_REGISTRY_RE = re.compile(r"^\d+\.json$")
_FROM_MODE_RE = re.compile(r'from-mode="([^"]*)"')
_FROM_RE = re.compile(r'\bfrom="([^"]*)"')

# `bypassPermissions` 之外一律当 prompting（保守）：二值里只有 bypass 实测过能直达。
# `auto` **量过了，归 prompting**（2026-11-06 第 12 轮，一次性会话）：
#   - 发送方是 auto ⇒ 目标 jsonl 那行 enqueue 写的是 `from-mode="prompting"`（3 次）
#   - 接收方是 auto、发送方是 bypass 信使 ⇒ 宿主 stdout 出 `peer_message_hold cause=mode-mismatch`（3/3）
#   与 Claude Code 源码一致：只有 bypassPermissions（和「plan + 可绕过」）算 bypass。所以这里不用改。
# acceptEdits / dontAsk 仍**没量过**。
_BYPASS_MODES = ("bypasspermissions", "bypass")

# ---------- 给手机用户看的话（语气参考 bridge/prefs.py） ----------

WHY_NOT_LIVE = "这个会话现在没开着。要接着聊，先在电脑上打开它。"
WHY_SUSPENDED = "它在电脑上被挂起了（按过 Ctrl-Z），发进去不会有人理。到电脑上敲 fg 让它继续。"
WHY_NO_NAME = "这个会话没有名字，发不了。在电脑上那个会话里用 /name 起个名字，再点 🔄 刷新。"
WHY_NAME_DUP = "电脑上有两个会话都叫这个名字，发过去可能进错一个。先在电脑上给其中一个改个名。"
WHY_NO_SOCKET = "这个会话的 Claude 版本还不支持会话间消息，从手机发不进去。在电脑上和它说吧。"
